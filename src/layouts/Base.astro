---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import AvisoMaqueta from '../components/AvisoMaqueta.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Grano from '../components/Grano.astro';
import { EMPRESA } from '../data/empresa';
import { textos, codigo, mismaPaginaEn, type Idioma } from '../i18n';

interface Props {
  titulo: string;
  descripcion: string;
  /** Por defecto español: las páginas que aún no son bilingües siguen igual. */
  idioma?: Idioma;
}

const { titulo, descripcion, idioma = 'es' } = Astro.props;
const t = textos(idioma);
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const base = Astro.site ?? Astro.url.origin;

/**
 * hreflang: le dice al buscador que estas dos páginas son la misma en dos
 * idiomas. Sin esto compiten entre sí en los resultados en lugar de sumar.
 */
const alternativas = [
  { codigo: 'es-ES', href: new URL(mismaPaginaEn('es', Astro.url.pathname), base).href },
  { codigo: 'en', href: new URL(mismaPaginaEn('en', Astro.url.pathname), base).href },
];
---

<!doctype html>
<html lang={codigo(idioma)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    {
      alternativas.map((a) => (
        <link rel="alternate" hreflang={a.codigo} href={a.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternativas[0].href} />

    <!-- Es una maqueta de demostración: no debe indexarse. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={EMPRESA.nombreCompleto} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content={idioma === 'en' ? 'en_GB' : 'es_ES'} />
    <meta name="theme-color" content="#14171c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <ClientRouter />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('con-revelado');
      }
    </script>
  </head>

  <body>
    <a class="saltar" href="#contenido">
      {idioma === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>

    <div class="avance" aria-hidden="true"><span data-avance></span></div>
    <AvisoMaqueta idioma={idioma} />
    <Cabecera idioma={idioma} />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} />
    <BotonWhatsApp />
    <Grano />

    <script>
      import { activarAnimaciones } from '../scripts/animaciones';
      import { activarPremium } from '../scripts/premium';

      const arrancar = () => {
        activarAnimaciones();
        activarPremium();
      };

      arrancar();
      document.addEventListener('astro:after-swap', arrancar);
    </script>
  </body>
</html>

<style is:global>
  /* Barra de avance de lectura. */
  .avance {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 3px;
    pointer-events: none;
  }

  .avance span {
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--laton-claro), var(--laton-hondo));
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .avance {
      display: none;
    }
  }

  /* Transición entre páginas: se funde, no parpadea. */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation: salirPagina 200ms var(--curva) both;
    }

    ::view-transition-new(root) {
      animation: entrarPagina 360ms var(--curva) both;
    }
  }

  @keyframes salirPagina {
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes entrarPagina {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
