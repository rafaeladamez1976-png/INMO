---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {
  PROMOCIONES,
  ESTADOS,
  desdePromocion,
  disponibilidad,
} from '../data/promociones';
import { OFICINAS, EMPRESA, telefonoLegible, enlaceTelefono } from '../data/empresa';
import { euros } from '../lib/hipoteca';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/inmuebles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const totales = PROMOCIONES.reduce(
  (suma, p) => {
    const d = disponibilidad(p);
    return { quedan: suma.quedan + d.quedan, total: suma.total + d.total };
  },
  { quedan: 0, total: 0 },
);

/**
 * Obra nueva.
 *
 * La sección que tiene la web de referencia y que faltaba aquí. Se compra
 * distinto que la segunda mano: importa el plazo, la promotora y cuántas
 * quedan, no las fotos de un salón que todavía no existe.
 */
---

<Base
  titulo="Obra nueva y promociones | Umbral Inmobiliaria"
  descripcion="Promociones de obra nueva en Madrid, Toledo y Badajoz. Con plazos, promotora y viviendas disponibles a la vista."
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">Obra nueva</p>
      <h1 class="portadilla__titulo">
        Estrenar<br /><span class="acento">sin sorpresas</span>
      </h1>
      <p class="portadilla__entrada">
        {PROMOCIONES.length} promociones en comercialización y {totales.quedan} viviendas
        disponibles de {totales.total}. Con la promotora, el plazo real y lo que
        conviene saber antes de firmar, que es justo lo que nadie te cuenta.
      </p>
    </header>

    <div class="promociones">
      {
        PROMOCIONES.map((promocion, i) => {
          const foto = fotos[`../assets/inmuebles/${promocion.imagen}.jpg`]?.default;
          const estado = ESTADOS[promocion.estado];
          const d = disponibilidad(promocion);
          const oficina = OFICINAS.find((o) => o.id === promocion.oficina);

          return (
            <article class="promo" data-revelar data-revelar-retraso={i * 90}>
              <a class="promo__foto" href={`/promocion/${promocion.id}`}>
                {foto && (
                  <Image
                    src={foto}
                    alt={`Promoción ${promocion.nombre} en ${promocion.zona}`}
                    widths={[500, 900, 1400]}
                    sizes="(max-width: 56rem) 92vw, 44vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    class="promo__imagen"
                  />
                )}
                <span class:list={['promo__estado', `promo__estado--${estado.tono}`]}>
                  {estado.nombre}
                </span>
              </a>

              <div class="promo__cuerpo">
                <p class="promo__zona">
                  {promocion.zona}, {promocion.provincia}
                </p>
                <h2 class="promo__nombre">
                  <a href={`/promocion/${promocion.id}`}>{promocion.nombre}</a>
                </h2>

                <dl class="promo__cifras">
                  <div>
                    <dt>Desde</dt>
                    <dd>{euros(desdePromocion(promocion))}</dd>
                  </div>
                  <div>
                    <dt>Entrega</dt>
                    <dd class="promo__texto">{promocion.entrega}</dd>
                  </div>
                  <div>
                    <dt>Quedan</dt>
                    <dd>
                      {d.quedan} <span>de {d.total}</span>
                    </dd>
                  </div>
                </dl>

                {/* Barra de vendidas: se entiende de un vistazo si corre prisa. */}
                <div
                  class="barra"
                  role="img"
                  aria-label={`Quedan ${d.quedan} viviendas de ${d.total}`}
                >
                  <span class="barra__llena" style={`--parte: ${((d.total - d.quedan) / d.total) * 100}%`} />
                </div>
                <p class="promo__vendidas">
                  {d.total - d.quedan} vendidas de {d.total}
                </p>

                <ul class="promo__incluye">
                  {promocion.incluye.slice(0, 3).map((cosa) => (
                    <li>{cosa}</li>
                  ))}
                </ul>

                <p class="promo__pie">
                  {oficina && (
                    <a class="promo__oficina" href={`/oficina/${oficina.id}`}>
                      Oficina de {oficina.nombre}
                    </a>
                  )}
                  <a class="promo__ver" href={`/promocion/${promocion.id}`}>
                    Ver la promoción
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M5 12h14M13 6l6 6-6 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </p>
              </div>
            </article>
          );
        })
      }
    </div>

    <section class="claves" data-revelar>
      <h2 class="claves__titulo">Comprar obra nueva no es comprar un piso usado</h2>
      <div class="claves__rejilla">
        <article class="clave">
          <h3 class="clave__titulo">Pagas IVA, no ITP</h3>
          <p>
            La obra nueva tributa al 10 % de IVA más el impuesto de actos
            jurídicos documentados, en lugar del 6 % de ITP de la segunda mano en
            Madrid. Sobre 200.000 € son unos 10.000 € más.
          </p>
        </article>
        <article class="clave">
          <h3 class="clave__titulo">Las entregas a cuenta van avaladas</h3>
          <p>
            Todo lo que pagues antes de la entrega tiene que estar cubierto por
            un aval o un seguro, por ley. Pide el documento y guárdalo: es lo que
            te devuelve el dinero si la promotora falla.
          </p>
        </article>
        <article class="clave">
          <h3 class="clave__titulo">Los plazos se mueven</h3>
          <p>
            Una entrega prevista no es una fecha cerrada. Deja margen de tres a
            seis meses y no dejes tu vivienda actual hasta que haya licencia de
            primera ocupación.
          </p>
        </article>
        <article class="clave">
          <h3 class="clave__titulo">La memoria de calidades manda</h3>
          <p>
            Lo que se entrega es lo que pone en la memoria, no lo que se ve en el
            piso piloto. Léela entera y pregunta por lo que no aparezca.
          </p>
        </article>
      </div>
    </section>

    <aside class="ayuda" data-revelar>
      <h2 class="ayuda__titulo">¿Vas a comprar sobre plano?</h2>
      <p>
        Te acompañamos a la visita, revisamos contigo la memoria de calidades y
        el aval, y te decimos si el precio se sostiene. Sin coste para ti.
      </p>
      <div class="ayuda__acciones">
        <a class="boton boton--laton" href="/cita">Pedir cita</a>
        <a class="boton boton--linea" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
          Llamar al {telefonoLegible(EMPRESA.telefonoGratuito)}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    max-width: 42rem;
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .promociones {
    display: grid;
    gap: var(--e-8);
  }

  @media (min-width: 56rem) {
    .promociones {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--e-10);
    }
  }

  .promo {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radio-grande);
    background: var(--papel);
    box-shadow: 0 2px 10px var(--sombra);
    transition:
      transform var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  @media (hover: hover) {
    .promo:hover {
      transform: translateY(-6px);
      box-shadow: 0 22px 50px var(--sombra-honda);
    }

    .promo:hover .promo__imagen {
      transform: scale(1.05);
    }
  }

  .promo__foto {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--grafito-medio);
  }

  .promo__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--curva);
  }

  .promo__estado {
    position: absolute;
    top: var(--e-4);
    left: var(--e-4);
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .promo__estado--laton {
    background: var(--laton);
    color: var(--grafito);
  }

  .promo__estado--oliva {
    background: var(--oliva);
    color: #fff;
  }

  .promo__estado--grafito {
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .promo__cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--e-6);
  }

  .promo__zona {
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .promo__nombre {
    margin-block: var(--e-2) var(--e-5);
    font-size: var(--t-grande);
    letter-spacing: -0.02em;
  }

  .promo__nombre a {
    text-decoration: none;
    color: inherit;
  }

  .promo__cifras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--e-3);
    padding-bottom: var(--e-5);
    border-bottom: 1px solid var(--arena-honda);
  }

  .promo__cifras dt {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .promo__cifras dd {
    margin: 0;
    margin-top: 0.2em;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .promo__cifras dd span {
    font-family: var(--fuente-texto);
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--texto-suave);
  }

  .promo__texto {
    font-size: 0.85rem !important;
    line-height: 1.3;
  }

  .barra {
    height: 4px;
    margin-top: var(--e-5);
    border-radius: 2px;
    background: var(--arena-honda);
    overflow: hidden;
  }

  .barra__llena {
    display: block;
    width: var(--parte);
    height: 100%;
    border-radius: 2px;
    background: var(--laton);
    transform-origin: left;
    animation: llenar 1s var(--curva) backwards 0.2s;
  }

  @keyframes llenar {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .barra__llena {
      animation: none;
    }
  }

  .promo__vendidas {
    margin-top: var(--e-2);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .promo__incluye {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: var(--e-5);
    margin-bottom: var(--e-5);
  }

  .promo__incluye li {
    padding: 0.2em 0.7em;
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .promo__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    margin-top: auto;
    padding-top: var(--e-4);
    border-top: 1px solid var(--arena-honda);
    font-size: var(--t-micro);
  }

  .promo__oficina {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--laton-hondo);
    text-decoration: none;
  }

  .promo__oficina:hover {
    text-decoration: underline;
  }

  .promo__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    font-weight: 700;
    text-decoration: none;
  }

  .promo__ver svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .promo__ver:hover svg {
      transform: translateX(3px);
    }
  }

  .claves {
    margin-top: var(--e-24);
  }

  .claves__titulo {
    max-width: 34rem;
    margin-bottom: var(--e-8);
    font-size: var(--t-titulo);
  }

  .claves__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    background: var(--arena-honda);
    border-block: 1px solid var(--arena-honda);
  }

  .clave {
    padding: var(--e-6);
    background: var(--papel);
  }

  .clave__titulo {
    margin-bottom: var(--e-3);
    font-size: var(--t-medio);
  }

  .clave p {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .ayuda {
    margin-top: var(--e-16);
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena-honda);
    text-align: center;
  }

  .ayuda__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .ayuda p {
    max-width: 38rem;
    margin-inline: auto;
    margin-bottom: var(--e-6);
  }

  .ayuda__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    justify-content: center;
  }

  @media (max-width: 30rem) {
    .ayuda__acciones {
      flex-direction: column;
    }
  }
</style>
