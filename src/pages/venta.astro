---
import Base from '../layouts/Base.astro';
import Buscador from '../components/Buscador.astro';
import { porOperacion } from '../data/inmuebles';

const inmuebles = porOperacion('venta');
---

<Base
  titulo="Viviendas en venta en Madrid | Umbral Inmobiliaria"
  descripcion="Pisos, chalets, casas y locales en venta en Madrid, Toledo y Extremadura."
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">Comprar</p>
      <h1 class="portadilla__titulo">Viviendas<br /><span class="acento">en venta</span></h1>
      <p class="portadilla__entrada">Pisos, chalets, casas y locales en venta en Madrid, Toledo y Extremadura.</p>
    </header>

    <Buscador inmuebles={inmuebles} />
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }
</style>
