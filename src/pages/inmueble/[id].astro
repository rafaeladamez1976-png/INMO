---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ficha from '../../components/Ficha.astro';
import Tour from '../../components/tour/Tour.astro';
import {
  INMUEBLES,
  OPERACIONES,
  TIPOS,
  precioLegible,
  parecidos,
} from '../../data/inmuebles';
import {
  OFICINAS,
  EMPRESA,
  telefonoLegible,
  enlaceTelefono,
  enlaceWhatsApp,
} from '../../data/empresa';
import Energia from '../../components/Energia.astro';
import { calcular, euros, desglosarGastos } from '../../lib/hipoteca';
import { tourDe } from '../../data/tours';

export function getStaticPaths() {
  return INMUEBLES.map((inmueble) => ({
    params: { id: inmueble.id },
    props: { inmueble },
  }));
}

const { inmueble } = Astro.props;
const { operacion, tipo } = inmueble;

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/inmuebles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const galeria = inmueble.galeria
  .map((nombre) => ({
    nombre,
    imagen: fotos[`../../assets/inmuebles/${nombre}.jpg`]?.default,
  }))
  .filter((f) => f.imagen);

const oficina = OFICINAS.find((o) => o.id === inmueble.oficina) ?? OFICINAS[0];
const similares = parecidos(inmueble);

/**
 * Cuota orientativa con la hipótesis más habitual: 20 % de entrada, 25 años y
 * un tipo del 3,2 %. Es el dato que todo el mundo calcula mentalmente al ver
 * un precio, así que se lo damos hecho.
 */
const hipoteca =
  operacion === 'venta'
    ? calcular({
        precio: inmueble.precio,
        entrada: inmueble.precio * 0.2,
        anios: 25,
        interes: 3.2,
      })
    : null;

/**
 * Gastos de compra, desglosados. Solo en venta: en alquiler no hay ITP ni
 * notaría, y poner la tabla ahí sería confundir a quien alquila.
 */
const gastos = operacion === 'venta' ? desglosarGastos(inmueble.precio) : null;
const totalGastos = gastos ? gastos.reduce((t, g) => t + g.importe, 0) : 0;

/** Precio por metro: el dato con el que se compara de verdad. */
const precioMetro = inmueble.metros > 0 ? inmueble.precio / inmueble.metros : 0;

const mensajeVisita = `Hola, me interesa el inmueble ${inmueble.id} (${inmueble.titulo}, ${inmueble.zona}). Quería concertar una visita.`;

/** Recorrido 360 propio de cada tipo: un local no enseña dormitorio. */
const estancias = tourDe(tipo);
---

<Base
  titulo={`${inmueble.titulo} en ${inmueble.zona} | Umbral Inmobiliaria`}
  descripcion={inmueble.descripcion.slice(0, 155)}
>
  <div class="contenedor">
    <nav class="miga" aria-label="Dónde estás">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href={operacion === 'venta' ? '/venta' : '/alquiler'}>
        {OPERACIONES[operacion].titulo}
      </a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{inmueble.zona}</span>
    </nav>

    <!-- Galería -->
    <section class="galeria" aria-label="Fotografías del inmueble">
      {
        galeria.map((foto, i) => (
          <figure class:list={['galeria__hueco', { 'galeria__hueco--principal': i === 0 }]}>
            <Image
              src={foto.imagen!}
              alt={`${TIPOS[tipo]} en ${inmueble.zona}`}
              widths={[600, 1000, 1600]}
              sizes={i === 0 ? '(max-width: 60rem) 92vw, 60vw' : '(max-width: 60rem) 46vw, 20vw'}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="galeria__imagen"
            />
          </figure>
        ))
      }
    </section>

    <div class="detalle">
      <div class="detalle__principal">
        <header class="cabeza">
          <p class="cabeza__zona">
            {TIPOS[tipo]} · {inmueble.zona}, {inmueble.provincia}
          </p>
          <h1 class="cabeza__titulo">{inmueble.titulo}</h1>
          <p class="cabeza__referencia">Referencia {inmueble.id.toUpperCase()}</p>
        </header>

        <ul class="datos">
          {
            inmueble.habitaciones > 0 && (
              <li>
                <span class="datos__cifra">{inmueble.habitaciones}</span>
                <span class="datos__nombre">Dormitorios</span>
              </li>
            )
          }
          <li>
            <span class="datos__cifra">{inmueble.banos}</span>
            <span class="datos__nombre">Baños</span>
          </li>
          <li>
            <span class="datos__cifra">{inmueble.metros}</span>
            <span class="datos__nombre">m² útiles</span>
          </li>
          {
            inmueble.planta && (
              <li>
                <span class="datos__cifra datos__cifra--texto">{inmueble.planta}</span>
                <span class="datos__nombre">Planta</span>
              </li>
            )
          }
        </ul>

        <section class="descripcion">
          <h2 class="apartado">Cómo es</h2>
          <p>{inmueble.descripcion}</p>

          {
            inmueble.aviso && (
              <p class="aviso">
                <strong>Lo que conviene saber:</strong> {inmueble.aviso}
              </p>
            )
          }
        </section>

        <section class="caracteristicas">
          <h2 class="apartado">Características</h2>
          <ul class="caracteristicas__lista">
            {inmueble.extras.map((extra) => <li>{extra}</li>)}
          </ul>
        </section>

        <section class="energia">
          <Energia energia={inmueble.energia} />
        </section>

        {
          gastos && (
            <section class="gastos">
              <h2 class="apartado">Lo que cuesta de verdad comprarlo</h2>
              <p class="gastos__entrada">
                Al precio hay que sumarle impuestos y papeleo. Aquí está el
                desglose para vivienda usada en la Comunidad de Madrid, para que
                nadie se lleve la sorpresa en la notaría.
              </p>

              <ul class="gastos__lista">
                {gastos.map((gasto) => (
                  <li class="gasto">
                    <div class="gasto__linea">
                      <span class="gasto__concepto">{gasto.concepto}</span>
                      <span class="gasto__importe">{euros(gasto.importe)}</span>
                    </div>
                    <p class="gasto__nota">{gasto.nota}</p>
                  </li>
                ))}
              </ul>

              <div class="gastos__suma">
                <div class="gastos__linea">
                  <span>Precio del inmueble</span>
                  <span>{euros(inmueble.precio)}</span>
                </div>
                <div class="gastos__linea">
                  <span>Gastos e impuestos</span>
                  <span>{euros(totalGastos)}</span>
                </div>
                <div class="gastos__linea gastos__linea--total">
                  <span>Desembolso total</span>
                  <span>{euros(inmueble.precio + totalGastos)}</span>
                </div>
              </div>

              <p class="gastos__pie">
                Cifras orientativas de agosto de 2026. La obra nueva tributa
                distinto: paga IVA del 10 % en lugar de ITP.
              </p>
            </section>
          )
        }

        <Tour estancias={estancias} />
      </div>

      <!-- Columna de contacto -->
      <aside class="lateral">
        <div class="tarjeta">
          <p class="tarjeta__operacion">{OPERACIONES[operacion].titulo}</p>
          <p class="tarjeta__precio">
            {precioLegible(inmueble.precio)}<span>{OPERACIONES[operacion].sufijo}</span>
          </p>

          {
            operacion === 'venta' && precioMetro > 0 && (
              <p class="tarjeta__metro">{euros(precioMetro)} el m² útil</p>
            )
          }

          {
            hipoteca && (
              <p class="tarjeta__hipoteca">
                Desde <strong>{euros(hipoteca.cuota)}/mes</strong> con un 20 % de
                entrada a 25 años.
                <a href="/calculadora-hipotecaria">Calcular la tuya</a>
              </p>
            )
          }

          <a
            class="boton boton--laton tarjeta__cta"
            href={enlaceWhatsApp(EMPRESA.whatsappCitas, mensajeVisita)}
          >
            Pedir visita
          </a>

          <a class="boton boton--linea tarjeta__llamar" href={enlaceTelefono(oficina.telefonos[0])}>
            Llamar a {oficina.nombre}
          </a>

          <div class="tarjeta__oficina">
            <p class="tarjeta__etiqueta">Lo lleva</p>
            <p class="tarjeta__nombre"><a class="tarjeta__enlace-oficina" href={`/oficina/${oficina.id}`}>Oficina de {oficina.nombre}</a></p>
            <address class="tarjeta__direccion">
              {oficina.direccion}<br />
              {oficina.cp} Madrid
            </address>
            <a class="tarjeta__telefono" href={enlaceTelefono(oficina.telefonos[0])}>
              {telefonoLegible(oficina.telefonos[0])}
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Parecidos -->
    {
      similares.length > 0 && (
        <section class="parecidos" aria-labelledby="titulo-parecidos">
          <h2 id="titulo-parecidos" class="parecidos__titulo" data-titular>
            Si este no es, mira estos
          </h2>
          <div class="parecidos__rejilla">
            {similares.map((otro, i) => (
              <Ficha inmueble={otro} retraso={i * 90} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <!--
    Barra de acciones de móvil.

    En pantalla pequeña la tarjeta de contacto queda al final de una página
    larga: quien llega por el móvil se lee la descripción, el certificado y los
    gastos, y para llamar tiene que seguir bajando. Todos los portales tienen
    esta barra; sin ella la versión de móvil pierde de hecho el contacto.
  -->
  <div class="acciones" data-acciones>
    <div class="acciones__precio">
      <p class="acciones__cifra">
        {precioLegible(inmueble.precio)}<span>{OPERACIONES[operacion].sufijo}</span>
      </p>
      {
        hipoteca && <p class="acciones__cuota">{euros(hipoteca.cuota)}/mes orientativo</p>
      }
    </div>

    <div class="acciones__botones">
      <button
        class="acciones__guardar"
        type="button"
        data-favorito={inmueble.id}
        aria-pressed="false"
        aria-label="Guardar en favoritos"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20s-7-4.4-7-9.3A4 4 0 0 1 12 8a4 4 0 0 1 7-2.7c0 4.9-7 9.3-7 9.3Z"
            transform="translate(0 1)"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <a class="acciones__llamar" href={enlaceTelefono(oficina.telefonos[0])} aria-label="Llamar">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <a
        class="acciones__visita"
        href={enlaceWhatsApp(EMPRESA.whatsappCitas, mensajeVisita)}
      >
        Pedir visita
      </a>
    </div>
  </div>
</Base>

<style>
  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    padding-block: var(--e-6) var(--e-4);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .miga a {
    text-decoration: none;
  }

  .miga a:hover {
    color: var(--laton-hondo);
  }

  /* ---- Galería ---- */

  .galeria {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--e-2);
    margin-bottom: var(--e-12);
  }

  @media (min-width: 56rem) {
    .galeria {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    .galeria__hueco--principal {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .galeria__hueco {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radio);
    aspect-ratio: 4 / 3;
    background: var(--grafito-medio);
  }

  .galeria__hueco--principal {
    grid-column: span 2;
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 56rem) {
    .galeria__hueco--principal {
      aspect-ratio: auto;
    }
  }

  .galeria__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--curva);
  }

  @media (hover: hover) {
    .galeria__hueco:hover .galeria__imagen {
      transform: scale(1.05);
    }
  }

  /* ---- Detalle ---- */

  .detalle {
    display: grid;
    gap: var(--e-8);
  }

  @media (min-width: 60rem) {
    .detalle {
      grid-template-columns: 1fr 21rem;
      gap: var(--e-12);
      align-items: start;
    }
  }

  .cabeza__zona {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .cabeza__titulo {
    margin-block: var(--e-2);
    font-size: var(--t-titulo);
  }

  .cabeza__referencia {
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    gap: var(--e-4);
    margin-block: var(--e-8);
    padding-block: var(--e-6);
    border-block: 1px solid var(--arena-honda);
  }

  .datos__cifra {
    display: block;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
  }

  .datos__cifra--texto {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .datos__nombre {
    display: block;
    margin-top: var(--e-1);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .apartado {
    margin-bottom: var(--e-3);
    font-size: var(--t-grande);
  }

  .descripcion {
    margin-bottom: var(--e-8);
  }

  .descripcion p {
    color: var(--texto-suave);
  }

  .aviso {
    margin-top: var(--e-4);
    padding: var(--e-4) var(--e-6);
    border-left: 3px solid var(--laton);
    border-radius: 0 var(--radio) var(--radio) 0;
    background: var(--arena-honda);
    font-size: var(--t-pequeno);
    color: var(--texto) !important;
  }

  .caracteristicas__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .caracteristicas__lista li {
    padding: var(--e-2) var(--e-4);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-pequeno);
  }

  /* ---- Tarjeta de contacto ---- */

  /*
    En movil la tarjeta va en el flujo normal. Pegada, se quedaria flotando
    sobre el contenido y taparia media pantalla en un telefono, que es justo
    donde mas falta hace ver la ficha.
  */
  .lateral {
    position: static;
  }

  @media (min-width: 60rem) {
    .lateral {
      position: sticky;
      top: 9rem;
    }
  }

  .tarjeta {
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
    box-shadow: 0 20px 50px var(--sombra-honda);
  }

  .tarjeta__operacion {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .tarjeta__precio {
    margin-block: var(--e-2) var(--e-4);
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 8, 'opsz' 144;
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 2.9rem);
    font-weight: 600;
    line-height: 1;
  }

  .tarjeta__precio span {
    font-family: var(--fuente-texto);
    font-size: var(--t-pequeno);
    opacity: 0.8;
  }

  .tarjeta__hipoteca {
    margin-bottom: var(--e-6);
    padding-bottom: var(--e-6);
    border-bottom: 1px solid rgba(244, 240, 233, 0.16);
    font-size: var(--t-pequeno);
    color: #cfc9bd;
  }

  .tarjeta__hipoteca strong {
    color: var(--laton-claro);
  }

  .tarjeta__hipoteca a {
    display: block;
    margin-top: var(--e-2);
    color: var(--texto-claro);
    font-weight: 700;
  }

  .tarjeta__cta,
  .tarjeta__llamar {
    width: 100%;
    margin-bottom: var(--e-3);
  }

  .tarjeta__llamar {
    color: var(--texto-claro);
    border-color: rgba(244, 240, 233, 0.4);
  }

  .tarjeta__oficina {
    margin-top: var(--e-6);
    padding-top: var(--e-6);
    border-top: 1px solid rgba(244, 240, 233, 0.16);
  }

  .tarjeta__etiqueta {
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9a948a;
  }

  .tarjeta__nombre {
    margin-top: var(--e-1);
    font-weight: 700;
  }

  .tarjeta__enlace-oficina {
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 240, 233, 0.35);
  }

  .tarjeta__enlace-oficina:hover {
    color: var(--laton-claro);
    border-bottom-color: var(--laton-claro);
  }

  .tarjeta__direccion {
    margin-block: var(--e-2);
    font-style: normal;
    font-size: var(--t-pequeno);
    color: #cfc9bd;
  }

  .tarjeta__telefono {
    font-weight: 700;
    color: var(--laton-claro);
  }

  /* ---- Parecidos ---- */

  .parecidos {
    margin-top: var(--e-24);
  }

  .parecidos__titulo {
    margin-bottom: var(--e-8);
    font-size: var(--t-titulo);
  }

  .parecidos__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--e-6);
  }

  /* ---- Certificado energético ---- */

  .energia {
    margin-top: var(--e-12);
  }

  /* ---- Gastos de compra ---- */

  .gastos {
    margin-top: var(--e-12);
  }

  .gastos__entrada {
    max-width: 40rem;
    margin-bottom: var(--e-6);
    color: var(--texto-suave);
  }

  .gastos__lista {
    border-top: 1px solid var(--arena-honda);
  }

  .gasto {
    padding-block: var(--e-4);
    border-bottom: 1px solid var(--arena-honda);
  }

  .gasto__linea {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-4);
  }

  .gasto__concepto {
    font-weight: 700;
  }

  .gasto__importe {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .gasto__nota {
    max-width: 42rem;
    margin-top: 0.25em;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .gastos__suma {
    margin-top: var(--e-6);
    padding: var(--e-5) var(--e-6);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .gastos__linea {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-2);
    font-size: var(--t-pequeno);
    font-variant-numeric: tabular-nums;
  }

  .gastos__linea--total {
    margin-top: var(--e-2);
    padding-top: var(--e-4);
    border-top: 1px solid rgba(244, 240, 233, 0.2);
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--laton-claro);
  }

  .gastos__pie {
    margin-top: var(--e-4);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .tarjeta__metro {
    margin-top: -0.4em;
    margin-bottom: var(--e-4);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #cfc9bd;
  }

  /* ---- Barra de acciones de móvil ---- */

  .acciones {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding: var(--e-3) var(--e-4);
    /* El hueco del gesto de inicio en los móviles sin botón físico. */
    padding-bottom: calc(var(--e-3) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--arena-honda);
    background: rgba(244, 240, 233, 0.97);
    backdrop-filter: blur(12px);
