---
import Base from '../../layouts/Base.astro';
import Agenda from '../../components/Agenda.astro';
import { EMPRESA, OFICINAS, telefonoLegible, enlaceTelefono } from '../../data/empresa';
import { textos, ruta as enlaceDe, rutasDeIdioma, type Idioma } from '../../i18n';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.cita;
---

<Base
  idioma={idioma}
  titulo={`${t.antetitulo} | ${EMPRESA.nombreCompleto}`}
  descripcion={t.descripcion}
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">{t.antetitulo}</p>
      <h1 class="portadilla__titulo">
        {t.titulo}<br /><span class="acento">{t.acento}</span>
      </h1>
      <p class="portadilla__entrada">{t.entrada}</p>
    </header>

    <Agenda idioma={idioma} />

    <aside class="alternativa" data-revelar>
      <h2 class="alternativa__titulo">{t.sinCita}</h2>
      <p>{t.sinCitaTexto(OFICINAS.length)}</p>
      <div class="alternativa__acciones">
        <a class="boton boton--linea" href={enlaceDe(idioma, '/oficinas')}>{t.verOficinas}</a>
        <a class="boton" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
          {todo.comun.llamarAl} {telefonoLegible(EMPRESA.telefonoGratuito)}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .alternativa {
    margin-top: var(--e-16);
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena-honda);
    text-align: center;
  }

  .alternativa__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .alternativa p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
  }

  .alternativa__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    justify-content: center;
  }
</style>
