---
import Base from '../../layouts/Base.astro';
import Heroe from '../../components/Heroe.astro';
import Ciudad from '../../components/ciudad/Ciudad.astro';
import Ficha from '../../components/Ficha.astro';
import Casa from '../../components/casa/Casa.astro';
import Testimonios from '../../components/Testimonios.astro';
import Barrios from '../../components/Barrios.astro';
import Tablon from '../../components/Tablon.astro';
import {
  EMPRESA,
  OFICINAS,
  SERVICIOS,
  telefonoLegible,
  enlaceTelefono,
} from '../../data/empresa';
import { destacados } from '../../data/inmuebles';
import { textos, ruta as enlaceDe, rutasDeIdioma, type Idioma } from '../../i18n';
import { SERVICIOS_EN } from '../../i18n/datos';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.portada;

const seleccion = destacados();

/** Servicios en el idioma que toca, con el español de reserva. */
const servicios = SERVICIOS.map((s) =>
  idioma === 'en' ? { ...s, ...(SERVICIOS_EN[s.id] ?? {}) } : s,
);
---

<Base
  idioma={idioma}
  titulo={`${EMPRESA.nombreCompleto} — ${t.titulo}`}
  descripcion={t.descripcion}
>
  <Heroe idioma={idioma} />

  <!-- Servicios -->
  <section class="servicios contenedor" aria-labelledby="titulo-servicios">
    <header class="seccion" data-revelar>
      <p class="antetitulo">{t.servicios.antetitulo}</p>
      <h2 id="titulo-servicios" class="seccion__titulo" data-titular>
        {t.servicios.titulo}
      </h2>
      <p class="seccion__entrada">{t.servicios.entrada}</p>
    </header>

    <ul class="servicios__rejilla">
      {
        servicios.map((servicio, i) => (
          <li class="servicio" data-revelar data-revelar-retraso={i * 70}>
            <span class="servicio__numero">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="servicio__titulo">{servicio.titulo}</h3>
            <p class="servicio__texto">{servicio.texto}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Captación: es de donde vive una inmobiliaria -->
  <section class="captacion" aria-labelledby="titulo-captacion">
    <div class="contenedor captacion__interior">
      <div data-revelar>
        <p class="antetitulo captacion__antetitulo">{t.captacion.antetitulo}</p>
        <h2 id="titulo-captacion" class="captacion__titulo" data-titular>
          {t.captacion.titulo}
        </h2>
        <p class="captacion__texto">{t.captacion.texto}</p>
        <div class="captacion__acciones">
          <a class="boton boton--laton" href={enlaceDe(idioma, '/valoracion')}>
            {t.captacion.boton}
          </a>
          <a
            class="boton boton--linea captacion__linea"
            href={enlaceTelefono(EMPRESA.telefonoGratuito)}
          >
            {telefonoLegible(EMPRESA.telefonoGratuito)}
          </a>
        </div>
      </div>

      <div class="captacion__casa" data-revelar data-revelar-retraso="140">
        <Casa alt={t.captacion.casaAlt} />
      </div>
    </div>

    <div class="contenedor">
      <ul class="captacion__pasos" data-revelar data-revelar-retraso="220">
        {
          t.captacion.pasos.map((paso) => (
            <li>
              <strong>{paso.fuerte}</strong> {paso.resto}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- El mapa 3D de los barrios donde trabajan -->
  <section class="barrios" aria-labelledby="titulo-barrios">
    <div class="contenedor barrios__cabecera" data-revelar>
      <p class="antetitulo barrios__antetitulo">{t.territorio.antetitulo}</p>
      <h2 id="titulo-barrios" class="barrios__titulo" data-titular>
        {t.territorio.titulo}
      </h2>
      <p class="barrios__entrada">{t.territorio.entrada}</p>
    </div>

    <Ciudad idioma={idioma} />
  </section>

  <Barrios idioma={idioma} />

  <!-- Inmuebles destacados -->
  <section class="destacados contenedor" aria-labelledby="titulo-destacados">
    <header class="seccion seccion--fila" data-revelar>
      <div>
        <p class="antetitulo">{t.destacados.antetitulo}</p>
        <h2 id="titulo-destacados" class="seccion__titulo" data-titular>
          {t.destacados.titulo}
        </h2>
      </div>
      <a class="boton boton--linea" href={enlaceDe(idioma, '/venta')}>{todo.comun.verTodos}</a>
    </header>

    <div class="destacados__rejilla">
      {
        seleccion.map((inmueble, i) => (
          <Ficha inmueble={inmueble} retraso={i * 90} idioma={idioma} />
        ))
      }
    </div>
  </section>

  <div class="contenedor">
    <Tablon cuantas={3} titulo={t.tablon} idioma={idioma} />
  </div>

  <Testimonios idioma={idioma} />

  <!-- Las cuatro oficinas -->
  <section class="oficinas contenedor" aria-labelledby="titulo-oficinas">
    <header class="seccion" data-revelar>
      <p class="antetitulo">{t.oficinas.antetitulo}</p>
      <h2 id="titulo-oficinas" class="seccion__titulo" data-titular>
        {t.oficinas.titulo}
      </h2>
      <p class="seccion__entrada">{t.oficinas.entrada}</p>
    </header>

    <ul class="oficinas__rejilla">
      {
        OFICINAS.map((oficina, i) => (
          <li class="oficina" data-revelar data-revelar-retraso={i * 80}>
            {oficina.sede && <span class="oficina__sede">{t.oficinas.sede}</span>}
            <h3 class="oficina__nombre">
              <a class="oficina__enlace" href={enlaceDe(idioma, `/oficina/${oficina.id}`)}>
                {oficina.nombre}
                <span class="oficina__area" aria-hidden="true" />
              </a>
            </h3>
            <p class="oficina__barrio">{oficina.barrio}</p>
            <address class="oficina__direccion">
              {oficina.direccion}
              <br />
              {oficina.cp} Madrid
            </address>
            <a class="oficina__telefono" href={enlaceTelefono(oficina.telefonos[0])}>
              {telefonoLegible(oficina.telefonos[0])}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .seccion {
    margin-bottom: var(--e-12);
  }

  .seccion--fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--e-6);
  }

  .seccion__titulo {
    margin-top: var(--e-3);
    font-size: var(--t-titulo);
  }

  .seccion__entrada {
    margin-top: var(--e-3);
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  /* ---- Servicios ---- */

  .servicios {
    padding-block: var(--e-24) var(--e-16);
  }

  .servicios__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--e-8);
  }

  .servicio {
    padding-top: var(--e-4);
    border-top: 2px solid var(--grafito);
  }

  .servicio__numero {
    display: block;
    font-family: var(--fuente-titular);
    font-size: var(--t-pequeno);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--laton-hondo);
  }

  .servicio__titulo {
    margin-block: var(--e-2);
    font-size: var(--t-medio);
  }

  .servicio__texto {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  /* ---- Captación ---- */

  .captacion {
    padding-block: var(--e-24);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .captacion__interior {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--e-12);
    align-items: center;
  }

  .captacion__antetitulo {
    color: var(--laton-claro);
  }

  .captacion__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-titulo);
  }

  .captacion__texto {
    color: #c3cbe2;
  }

  .captacion__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-8);
  }

  .captacion__linea {
    color: var(--texto-claro);
    border-color: rgba(246, 248, 252, 0.35);
  }

  .captacion__casa {
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .captacion__pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--e-4);
    margin-top: var(--e-12);
  }

  .captacion__pasos li {
    padding: var(--e-4) var(--e-6);
    border-left: 2px solid var(--laton);
    background: rgba(246, 248, 252, 0.04);
    font-size: var(--t-pequeno);
    color: #c3cbe2;
  }

  .captacion__pasos strong {
    display: block;
    color: var(--texto-claro);
    font-size: var(--t-base);
  }

  /* ---- Barrios ---- */

  .barrios {
    position: relative;
    padding-top: var(--e-24);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .barrios__cabecera {
    position: relative;
    z-index: 3;
    padding-bottom: var(--e-8);
  }

  .barrios__antetitulo {
    color: var(--laton-claro);
  }

  .barrios__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-titulo);
  }

  .barrios__entrada {
    max-width: 32rem;
    color: #c3cbe2;
  }

  /* ---- Destacados ---- */

  .destacados {
    padding-block: var(--e-24);
  }

  .destacados__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--e-6);
  }

  /* ---- Oficinas ---- */

  .oficinas {
    padding-bottom: var(--e-16);
  }

  .oficinas__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--e-4);
  }

  .oficina {
    position: relative;
    padding: var(--e-6);
    transition:
      transform var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-grande);
    background: var(--papel);
  }

  .oficina__sede {
    display: inline-block;
    margin-bottom: var(--e-2);
    padding: 0.15em 0.7em;
    border-radius: var(--radio-pildora);
    background: var(--laton);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .oficina__nombre {
    font-size: var(--t-medio);
  }

  .oficina__enlace {
    text-decoration: none;
  }

  /* Area de pulsacion que cubre la tarjeta entera. */
  .oficina__area {
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .oficina:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px var(--sombra);
    }

    .oficina:hover .oficina__enlace {
      color: var(--laton-hondo);
    }
  }

  .oficina__barrio {
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .oficina__direccion {
    margin-block: var(--e-4) var(--e-3);
    font-style: normal;
    font-size: var(--t-pequeno);
    line-height: 1.7;
    color: var(--texto-suave);
  }

  .oficina__telefono {
    font-weight: 700;
    font-size: var(--t-pequeno);
  }

  @media (max-width: 30rem) {
    .captacion__acciones {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
