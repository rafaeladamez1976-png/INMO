---
import Base from '../../layouts/Base.astro';
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../../data/empresa';
import { textos, ruta as enlaceDe, rutasDeIdioma, type Idioma } from '../../i18n';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.privacidad;
---

<Base
  idioma={idioma}
  titulo={`${t.tituloPagina} | ${EMPRESA.nombreCompleto}`}
  descripcion={t.descripcion}
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">{t.antetitulo}</p>
      <h1 class="portadilla__titulo">
        {t.titulo}<br /><span class="acento">{t.acento}</span>
      </h1>
      <p class="portadilla__entrada">{t.entrada}</p>
    </header>

    <div class="prosa" data-revelar>
      <h2>{t.quienTitulo}</h2>
      <p>{t.quienTexto}</p>

      <h2>{t.queTitulo}</h2>
      <ul>
        {
          t.queLista.map((linea) => (
            <li>
              <strong>{linea.fuerte}</strong> {linea.resto}
            </li>
          ))
        }
      </ul>

      <h2>{t.cuantoTitulo}</h2>
      <p>{t.cuantoTexto}</p>

      <h2>{t.compartimosTitulo}</h2>
      <p>{t.compartimosTexto}</p>

      <h2>{t.derechosTitulo}</h2>
      <p>{t.derechosTexto}</p>

      <h2>{t.cookiesTitulo}</h2>
      <p>{t.cookiesTexto}</p>

      <p>
        <strong>{t.notaFuerte}</strong> {t.notaResto}
      </p>
    </div>

    <aside class="cierre" data-revelar>
      <h2>{t.cierreTitulo}</h2>
      <p>{t.cierreTexto}</p>
      <div class="cierre__acciones">
        <a class="boton boton--laton" href={enlaceDe(idioma, '/cita')}>
          {todo.comun.pedirCita}
        </a>
        <a class="boton boton--linea cierre__linea" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
          {telefonoLegible(EMPRESA.telefonoGratuito)}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .bloques {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-8);
    margin-bottom: var(--e-16);
  }

  .bloque {
    padding-top: var(--e-4);
    border-top: 2px solid var(--grafito);
  }

  .bloque h2,
  .bloque h3 {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .bloque p {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .prosa {
    max-width: 42rem;
    margin-bottom: var(--e-16);
  }

  .prosa h2 {
    margin-block: var(--e-8) var(--e-3);
    font-size: var(--t-grande);
  }

  .prosa p,
  .prosa li {
    margin-bottom: var(--e-3);
    color: var(--texto-suave);
  }

  .prosa ul {
    margin-bottom: var(--e-4);
    padding-left: var(--e-6);
    list-style: disc;
  }

  .cierre {
    padding: var(--e-12) var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
    text-align: center;
  }

  .cierre h2 {
    margin-bottom: var(--e-3);
    font-size: var(--t-grande);
  }

  .cierre p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
    color: #cfc9bd;
  }

  .cierre__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    justify-content: center;
  }

  .cierre__linea {
    color: var(--texto-claro);
    border-color: rgba(244, 240, 233, 0.4);
  }
</style>
