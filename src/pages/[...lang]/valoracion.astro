---
import Base from '../../layouts/Base.astro';
import Valoracion from '../../components/Valoracion.astro';
import Casa from '../../components/casa/Casa.astro';
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../../data/empresa';
import { textos, rutasDeIdioma, type Idioma } from '../../i18n';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.valoracion;
---

<Base
  idioma={idioma}
  titulo={`${t.tituloPagina} | ${EMPRESA.nombreCompleto}`}
  descripcion={t.entrada}
>
  <div class="contenedor">
    <header class="portadilla portadilla--casa">
      <div data-revelar>
        <p class="antetitulo">{t.antetitulo}</p>
        <h1 class="portadilla__titulo">
          {t.titulo}<br /><span class="acento">{t.acento}</span>?
        </h1>
        <p class="portadilla__entrada">{t.entrada}</p>

        <ul class="promesas">
          {
            t.ventajas.map((v) => (
              <li>
                <strong>{v.titulo}</strong>
                <span>{v.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="portadilla__casa" data-revelar data-revelar-retraso="160">
        <Casa alt={todo.portada.captacion.casaAlt} />
      </div>
    </header>

    <Valoracion idioma={idioma} />

    <aside class="prefiero" data-revelar>
      <h2 class="prefiero__titulo">{t.hablamos}</h2>
      <p>{t.hablamosTexto}</p>
      <a class="boton" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
        {todo.comun.llamarAl} {telefonoLegible(EMPRESA.telefonoGratuito)}
      </a>
    </aside>
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla--casa {
    display: grid;
    gap: var(--e-8);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .portadilla--casa {
      grid-template-columns: 1fr 26rem;
      gap: var(--e-16);
    }
  }

  .portadilla__casa {
    order: -1;
  }

  @media (min-width: 60rem) {
    .portadilla__casa {
      order: 0;
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .promesas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--e-6);
    margin-top: var(--e-12);
  }

  .promesas li {
    padding-top: var(--e-3);
    border-top: 2px solid var(--laton);
  }

  .promesas strong {
    display: block;
    margin-bottom: var(--e-1);
  }

  .promesas span {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .prefiero {
    margin-top: var(--e-16);
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena-honda);
    text-align: center;
  }

  .prefiero__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .prefiero p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
  }
</style>
