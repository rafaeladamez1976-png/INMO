---
import Base from '../../layouts/Base.astro';
import { INMUEBLES, TIPOS } from '../../data/inmuebles';
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../../data/empresa';
import { textos, ruta as enlaceDe, rutasDeIdioma, type Idioma } from '../../i18n';
import { tipoDe } from '../../i18n/datos';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.alertas;

const zonas = [...new Set(INMUEBLES.map((i) => i.zona))].sort();
const tipos = Object.entries(TIPOS) as [keyof typeof TIPOS, string][];

/**
 * Alertas de inmuebles.
 *
 * Lo que hacen todos los portales: dices qué buscas y te avisan cuando entra
 * algo. Aquí no hay servidor ni base de datos, así que el formulario compone un
 * mensaje de WhatsApp con los criterios y la oficina te apunta a mano.
 *
 * Se dice en pantalla tal cual. Prometer un aviso automático que no existe es
 * la clase de cosa que se descubre a la tercera semana sin recibir nada.
 *
 * De propina, la página cuenta en vivo cuántos inmuebles encajan ya con lo que
 * pides: si hay tres ahora mismo, no hace falta esperar a ninguna alerta.
 */
---

<Base
  idioma={idioma}
  titulo={`${t.antetitulo} | ${EMPRESA.nombreCompleto}`}
  descripcion={t.descripcion}
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">{t.antetitulo}</p>
      <h1 class="portadilla__titulo">
        {t.titulo}<br /><span class="acento">{t.acento}</span>
      </h1>
      <p class="portadilla__entrada">{t.entrada}</p>
    </header>

    <div class="alerta">
      <form
        class="alerta__campos"
        data-alerta
        data-idioma={idioma}
        data-texto-encaja={t.encajaUno}
        data-texto-encajan={t.encajanVarios}
        data-mes={todo.comun.mes}
        data-msg-saludo={t.mensaje.saludo}
        data-msg-comprar={t.mensaje.comprar}
        data-msg-alquilar={t.mensaje.alquilar}
        data-msg-lo-que-sea={t.mensaje.loQueSea}
        data-msg-dormitorios={t.mensaje.dormitorios(0).replace('0', '{n}')}
        data-msg-hasta={t.mensaje.hasta('{p}')}
        data-msg-en={t.mensaje.en('{z}')}
        data-msg-cualquier-zona={t.mensaje.cualquierZona}
        data-msg-gracias={t.mensaje.gracias}
      >
        <fieldset class="grupo">
          <legend class="grupo__titulo">{t.queBuscas}</legend>

          <div class="grupo__fila">
            <label class="campo">
              <span class="campo__nombre">{t.operacion}</span>
              <select class="campo__control" name="operacion">
                <option value="venta">{t.comprar}</option>
                <option value="alquiler">{t.alquilar}</option>
              </select>
            </label>

            <label class="campo">
              <span class="campo__nombre">{t.tipo}</span>
              <select class="campo__control" name="tipo">
                <option value="">{t.cualquiera}</option>
                {tipos.map(([id, nombre]) => <option value={id}>{tipoDe(id, nombre, idioma)}</option>)}
              </select>
            </label>

            <label class="campo">
              <span class="campo__nombre">{t.dormitoriosMin}</span>
              <select class="campo__control" name="habitaciones">
                <option value="">{t.losQueSean}</option>
                {
                  [1, 2, 3, 4].map((n) => (
                    <option value={String(n)}>
                      {n} {t.oMas}
                    </option>
                  ))
                }
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset class="grupo">
          <legend class="grupo__titulo">{t.donde}</legend>
          <p class="grupo__pista">{t.dondePista}</p>
          <div class="zonas">
            {
              zonas.map((zona) => (
                <label class="zona">
                  <input type="checkbox" name="zona" value={zona} />
                  <span>{zona}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="grupo">
          <legend class="grupo__titulo">{t.hastaCuanto}</legend>
          <label class="campo campo--precio">
            <span class="campo__fila">
              <span class="campo__nombre">{t.precioMaximo}</span>
              <output class="campo__valor" data-salida-precio></output>
            </span>
            <input type="range" name="precio" min="0" max="600000" step="10000" value="250000" />
          </label>
        </fieldset>
      </form>

      <aside class="resumen">
        <p class="resumen__etiqueta">{t.ahoraTenemos}</p>
        <p class="resumen__cifra" data-encajan role="status">0</p>
        <p class="resumen__texto" data-encajan-texto>{t.encajanVarios}</p>

        <a class="boton boton--laton resumen__cta" data-enviar href="#">{t.avisadme}</a>

        <a class="resumen__ver" data-ver href={enlaceDe(idioma, '/venta')}>{t.verLosQueHay}</a>

        <p class="resumen__letra">{t.letraPequena}</p>
      </aside>
    </div>

    <section class="pasos" data-revelar>
      <h2 class="pasos__titulo">{t.comoFunciona}</h2>
      <ol class="pasos__lista">
        {
          t.pasos.map((paso, i) => (
            <li>
              <span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="paso__titulo">{paso.titulo}</h3>
              <p>{paso.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="ayuda" data-revelar>
      <h2 class="ayuda__titulo">{t.hablando}</h2>
      <p>{t.hablandoTexto}</p>
      <a class="boton" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
        {todo.comun.llamarAl} {telefonoLegible(EMPRESA.telefonoGratuito)}
      </a>
    </aside>
  </div>
</Base>

<script>
  import { INMUEBLES, TIPOS } from '../../data/inmuebles';
  import { EMPRESA, enlaceWhatsApp } from '../../data/empresa';
  import { TIPOS_EN } from '../../i18n/datos';

  function activarAlertas() {
    const formulario = document.querySelector<HTMLFormElement>('[data-alerta]');
    if (!formulario) return;

    const salidaPrecio = document.querySelector<HTMLOutputElement>('[data-salida-precio]')!;
    const cifra = document.querySelector<HTMLElement>('[data-encajan]')!;
    const texto = document.querySelector<HTMLElement>('[data-encajan-texto]')!;
    const enviar = document.querySelector<HTMLAnchorElement>('[data-enviar]')!;
    const ver = document.querySelector<HTMLAnchorElement>('[data-ver]')!;

    const dice = formulario.dataset;
    const ingles = dice.idioma === 'en';
    const euros = (n: number) =>
      ingles ? `€${n.toLocaleString('en-GB')}` : `${n.toLocaleString('es-ES')} €`;

    const leer = () => {
      const datos = new FormData(formulario);
      return {
        operacion: String(datos.get('operacion') ?? 'venta'),
        tipo: String(datos.get('tipo') ?? ''),
        habitaciones: Number(datos.get('habitaciones') ?? 0),
        precio: Number(datos.get('precio') ?? 0),
        zonas: datos.getAll('zona').map(String),
      };
    };

    const refrescar = () => {
      const c = leer();

      // El tope de un alquiler no se mide en cientos de miles: la misma barra
      // sirve para los dos casos cambiando la escala.
      const tope = c.operacion === 'alquiler' ? 3000 : 600000;
      const barra = formulario.elements.namedItem('precio') as HTMLInputElement;
      if (Number(barra.max) !== tope) {
        barra.max = String(tope);
        barra.step = c.operacion === 'alquiler' ? '50' : '10000';
        barra.value = String(Math.round(tope * 0.42));
        c.precio = Number(barra.value);
      }

      salidaPrecio.textContent =
        euros(c.precio) + (c.operacion === 'alquiler' ? ` ${dice.mes ?? 'al mes'}` : '');

      const encajan = INMUEBLES.filter(
        (i) =>
          i.operacion === c.operacion &&
          (!c.tipo || i.tipo === c.tipo) &&
          (!c.habitaciones || i.habitaciones >= c.habitaciones) &&
          i.precio <= c.precio &&
          (c.zonas.length === 0 || c.zonas.includes(i.zona)),
      );

      cifra.textContent = String(encajan.length);
      texto.textContent =
        encajan.length === 1
          ? (dice.textoEncaja ?? 'que encaja con lo que pides')
          : (dice.textoEncajan ?? 'que encajan con lo que pides');

      ver.href = c.operacion === 'alquiler' ? '/alquiler' : '/venta';
      ver.hidden = encajan.length === 0;

      // El mensaje va escrito en cristiano: quien lo recibe en la oficina
      // tiene que poder apuntarlo sin descifrar nada.
      const nombreTipo = (id: string) =>
        ingles
          ? (TIPOS_EN[id] ?? TIPOS[id as keyof typeof TIPOS])
          : TIPOS[id as keyof typeof TIPOS];

      const partes = [
        c.operacion === 'alquiler'
          ? (dice.msgAlquilar ?? 'alquilar')
          : (dice.msgComprar ?? 'comprar'),
        c.tipo ? nombreTipo(c.tipo).toLowerCase() : (dice.msgLoQueSea ?? 'lo que sea'),
        c.habitaciones
          ? (dice.msgDormitorios ?? 'de {n} dormitorios o más').replace(
              '{n}',
              String(c.habitaciones),
            )
          : '',
        (dice.msgHasta ?? 'hasta {p}').replace(
          '{p}',
          euros(c.precio) + (c.operacion === 'alquiler' ? ` ${dice.mes ?? 'al mes'}` : ''),
        ),
        c.zonas.length
          ? (dice.msgEn ?? 'en {z}').replace('{z}', c.zonas.join(', '))
          : (dice.msgCualquierZona ?? 'en cualquiera de vuestras zonas'),
      ].filter(Boolean);

      enviar.href = enlaceWhatsApp(
        EMPRESA.whatsappCitas,
        `${dice.msgSaludo ?? 'Hola, quiero que me aviséis cuando entre algo. Busco'} ` +
          `${partes.join(', ')}. ${dice.msgGracias ?? 'Gracias.'}`,
      );
    };

    formulario.addEventListener('input', refrescar);
    formulario.addEventListener('change', refrescar);
    refrescar();
  }

  activarAlertas();
  document.addEventListener('astro:after-swap', activarAlertas);
</script>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    max-width: 40rem;
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .alerta {
    display: grid;
    gap: var(--e-8);
  }

  @media (min-width: 56rem) {
    .alerta {
      grid-template-columns: 1fr 20rem;
      gap: var(--e-12);
      align-items: start;
    }
  }

  .grupo {
    padding: 0;
    border: 0;
    margin-bottom: var(--e-8);
  }

  .grupo__titulo {
    margin-bottom: var(--e-4);
    padding: 0;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .grupo__pista {
    margin-top: -0.6em;
    margin-bottom: var(--e-4);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .grupo__fila {
    display: grid;
    gap: var(--e-4);
  }

  @media (min-width: 40rem) {
    .grupo__fila {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .campo {
    display: block;
  }

  .campo__nombre {
    display: block;
    margin-bottom: var(--e-2);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .campo__control {
    width: 100%;
    min-height: 3rem;
    padding: var(--e-2) var(--e-4);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio);
    background: var(--papel);
    font: inherit;
    font-size: var(--t-pequeno);
  }

  .campo__control:focus-visible {
    outline: 2px solid var(--laton);
    outline-offset: 2px;
  }

  .campo__fila {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-3);
    margin-bottom: var(--e-3);
  }

  .campo__valor {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .campo--precio input {
    width: 100%;
    accent-color: var(--laton);
  }

  .zonas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  /* La casilla se esconde y la etiqueta entera hace de botón: en el móvil se
     acierta mucho mejor que con un cuadradito de doce píxeles. */
  .zona input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .zona span {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding-inline: var(--e-4);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-pequeno);
    cursor: pointer;
    transition:
      background-color var(--dur-corta) var(--curva),
      border-color var(--dur-corta) var(--curva),
      color var(--dur-corta) var(--curva);
  }

  .zona input:checked + span {
    background: var(--grafito);
    border-color: var(--grafito);
    color: var(--texto-claro);
  }

  .zona input:focus-visible + span {
    outline: 2px solid var(--laton);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .zona span:hover {
      border-color: var(--laton);
    }
  }

  .resumen {
    padding: var(--e-6);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  @media (min-width: 56rem) {
    .resumen {
      position: sticky;
      top: 7rem;
    }
  }

  .resumen__etiqueta {
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .resumen__cifra {
    margin-block: var(--e-1);
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .resumen__texto {
    margin-bottom: var(--e-6);
    font-size: var(--t-pequeno);
    color: #cfc9bd;
  }

  .resumen__cta {
    width: 100%;
  }

  .resumen__ver {
    display: block;
    margin-top: var(--e-4);
    font-size: var(--t-pequeno);
    text-align: center;
    color: var(--laton-claro);
  }

  .resumen__letra {
    margin-top: var(--e-6);
    padding-top: var(--e-5);
    border-top: 1px solid rgba(244, 240, 233, 0.18);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: #9a948a;
  }

  .pasos {
    margin-top: var(--e-24);
  }

  .pasos__titulo {
    margin-bottom: var(--e-8);
    font-size: var(--t-titulo);
  }

  .pasos__lista {
    display: grid;
    gap: var(--e-8);
    border-top: 1px solid var(--arena-honda);
    padding-top: var(--e-8);
  }

  @media (min-width: 48rem) {
    .pasos__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e-10);
    }
  }

  .paso__numero {
    display: block;
    margin-bottom: var(--e-3);
    font-family: var(--fuente-titular);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--laton);
  }

  .paso__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .pasos__lista p {
    color: var(--texto-suave);
  }

  .ayuda {
    margin-top: var(--e-16);
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena-honda);
    text-align: center;
  }

  .ayuda__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .ayuda p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
  }
</style>
