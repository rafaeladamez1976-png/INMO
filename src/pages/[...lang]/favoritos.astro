---
import Base from '../../layouts/Base.astro';
import Ficha from '../../components/Ficha.astro';
import { INMUEBLES } from '../../data/inmuebles';
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../../data/empresa';
import { textos, ruta as enlaceDe, rutasDeIdioma, type Idioma } from '../../i18n';

export function getStaticPaths() {
  return rutasDeIdioma();
}

const { idioma } = Astro.props as { idioma: Idioma };
const todo = textos(idioma);
const t = todo.favoritos;

/**
 * Tus favoritos.
 *
 * Se podían marcar inmuebles pero no había dónde verlos, que es como poner un
 * carrito sin página de carrito. Se pintan todos y el navegador oculta los que
 * no estén guardados: así funciona sin servidor y sin cuenta de usuario.
 */
---

<Base
  idioma={idioma}
  titulo={`${t.antetitulo} | ${EMPRESA.nombreCompleto}`}
  descripcion={t.descripcion}
>
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">{t.antetitulo}</p>
      <h1 class="portadilla__titulo">{t.titulo}<br /><span class="acento">{t.acento}</span></h1>
      <p class="portadilla__entrada">{t.entrada}</p>
    </header>

    <div
      class="favoritos"
      data-pagina-favoritos
      data-idioma={idioma}
      data-texto-uno={t.unoGuardado}
      data-texto-varios={t.variosGuardados(0).replace('0', '{n}')}
      data-texto-confirmar={t.confirmarVaciar}
      data-texto-mensaje={t.mensaje('{lista}')}
    >
      <!-- Vacío: lo que ve quien todavía no ha guardado nada -->
      <div class="vacio" data-vacio hidden>
        <svg class="vacio__icono" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20s-7-4.4-7-9.3A4 4 0 0 1 12 8a4 4 0 0 1 7-2.7c0 4.9-7 9.3-7 9.3Z"
            transform="translate(0 1)"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <h2 class="vacio__titulo">{t.vacioTitulo}</h2>
        <p class="vacio__texto">{t.vacioTexto}</p>
        <div class="vacio__acciones">
          <a class="boton boton--laton" href={enlaceDe(idioma, '/venta')}>{t.verVenta}</a>
          <a class="boton boton--linea" href={enlaceDe(idioma, '/alquiler')}>{t.verAlquiler}</a>
        </div>
      </div>

      <!-- Con favoritos -->
      <div data-lleno hidden>
        <div class="barra">
          <p class="barra__cuenta" data-cuenta role="status"></p>
          <div class="barra__acciones">
            <a class="boton boton--laton" data-compartir href="#">{t.consultar}</a>
            <button class="barra__vaciar" type="button" data-vaciar>{t.vaciar}</button>
          </div>
        </div>

        <div class="rejilla">
          {
            INMUEBLES.map((inmueble, i) => (
              <div class="rejilla__hueco" data-inmueble={inmueble.id} hidden>
                <Ficha inmueble={inmueble} retraso={(i % 3) * 70} idioma={idioma} />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <aside class="ayuda" data-revelar>
      <h2 class="ayuda__titulo">{t.ayudaTitulo}</h2>
      <p>{t.ayudaTexto}</p>
      <a class="boton" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
        {todo.comun.llamarAl} {telefonoLegible(EMPRESA.telefonoGratuito)}
      </a>
    </aside>
  </div>
</Base>

<script>
  import { INMUEBLES } from '../../data/inmuebles';
  import { EMPRESA, enlaceWhatsApp } from '../../data/empresa';

  const CLAVE = 'raiz:favoritos';

  function leer(): string[] {
    try {
      const bruto = localStorage.getItem(CLAVE);
      return bruto ? (JSON.parse(bruto) as string[]) : [];
    } catch {
      return [];
    }
  }

  function pintar() {
    const raiz = document.querySelector<HTMLElement>('[data-pagina-favoritos]');
    if (!raiz) return;

    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    const lleno = raiz.querySelector<HTMLElement>('[data-lleno]')!;
    const cuenta = raiz.querySelector<HTMLElement>('[data-cuenta]')!;
    const compartir = raiz.querySelector<HTMLAnchorElement>('[data-compartir]')!;
    const vaciar = raiz.querySelector<HTMLButtonElement>('[data-vaciar]')!;

    const guardados = leer();

    for (const hueco of raiz.querySelectorAll<HTMLElement>('[data-inmueble]')) {
      hueco.hidden = !guardados.includes(hueco.dataset.inmueble!);
    }

    vacio.hidden = guardados.length > 0;
    lleno.hidden = guardados.length === 0;

    const dice = raiz.dataset;
    cuenta.textContent =
      guardados.length === 1
        ? (dice.textoUno ?? '1 inmueble guardado')
        : (dice.textoVarios ?? '{n} inmuebles guardados').replace(
            '{n}',
            String(guardados.length),
          );

    // El mensaje lleva la lista ya escrita: el comercial sabe de que se habla
    // sin tener que preguntar referencias una por una.
    const lista = guardados
      .map((id) => INMUEBLES.find((i) => i.id === id))
      .filter(Boolean)
      .map((i) => `${i!.id.toUpperCase()} (${i!.titulo}, ${i!.zona})`)
      .join('; ');

    compartir.href = enlaceWhatsApp(
      EMPRESA.whatsappCitas,
      (dice.textoMensaje ?? 'Hola, me interesan estos inmuebles: {lista}.').replace(
        '{lista}',
        lista,
      ),
    );

    vaciar.onclick = () => {
      if (!confirm(dice.textoConfirmar ?? '¿Quitar todos los guardados?')) return;
      try {
        localStorage.removeItem(CLAVE);
      } catch {
        /* sin almacenamiento no hay nada que borrar */
      }
      pintar();
    };
  }

  pintar();
  document.addEventListener('astro:after-swap', pintar);
  // Al quitar un corazon desde esta misma pagina hay que repintar.
  document.addEventListener('click', (evento) => {
    if ((evento.target as HTMLElement)?.closest('[data-favorito]')) {
      setTimeout(pintar, 0);
    }
  });
</script>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .vacio {
    padding: var(--e-16) var(--e-8);
    border: 1px dashed var(--arena-honda);
    border-radius: var(--radio-grande);
    text-align: center;
  }

  .vacio__icono {
    width: 3.4rem;
    height: 3.4rem;
    margin-inline: auto;
    color: var(--laton);
  }

  .vacio__titulo {
    margin-block: var(--e-4) var(--e-3);
    font-size: var(--t-grande);
  }

  .vacio__texto {
    margin-inline: auto;
    color: var(--texto-suave);
  }

  .vacio__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    justify-content: center;
    margin-top: var(--e-8);
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    margin-bottom: var(--e-8);
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--arena-honda);
  }

  .barra__cuenta {
    font-weight: 700;
  }

  .barra__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
  }

  .barra__vaciar {
    padding: var(--e-2) var(--e-4);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    background: none;
    font-size: var(--t-micro);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .barra__vaciar:hover {
      background: var(--grafito);
      border-color: var(--grafito);
      color: var(--texto-claro);
    }
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--e-6);
  }

  .rejilla__hueco[hidden] {
    display: none;
  }

  .ayuda {
    margin-top: var(--e-16);
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena-honda);
    text-align: center;
  }

  .ayuda__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .ayuda p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
  }

  @media (max-width: 30rem) {
    .barra {
      flex-direction: column;
      align-items: stretch;
    }

    .barra__acciones {
      flex-direction: column;
      align-items: stretch;
    }

    .vacio {
      padding: var(--e-12) var(--e-6);
    }

    .vacio__acciones {
      flex-direction: column;
    }
  }
</style>
