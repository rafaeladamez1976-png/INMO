---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import {
  PROMOCIONES,
  ESTADOS,
  desdePromocion,
  disponibilidad,
} from '../../../data/promociones';
import {
  OFICINAS,
  EMPRESA,
  telefonoLegible,
  enlaceTelefono,
  enlaceWhatsApp,
} from '../../../data/empresa';
import { calcular } from '../../../lib/hipoteca';
import { textos, ruta as enlaceDe, IDIOMAS, type Idioma } from '../../../i18n';
import { PROMOCIONES_EN, ESTADOS_EN, precioDe } from '../../../i18n/datos';

/** Cuatro promociones por dos idiomas: ocho páginas. */
export function getStaticPaths() {
  return IDIOMAS.flatMap((lengua) =>
    PROMOCIONES.map((promocion) => ({
      params: { lang: lengua.id === 'es' ? undefined : lengua.id, id: promocion.id },
      props: { promocion, idioma: lengua.id },
    })),
  );
}

const { promocion, idioma } = Astro.props as {
  promocion: (typeof PROMOCIONES)[0];
  idioma: Idioma;
};

const todo = textos(idioma);
const tt = todo.promocion;
const euros = (n: number) => precioDe(Math.round(n), idioma);

/** Prosa de la promoción en el idioma que toca, con el español de reserva. */
const suyo = idioma === 'en' ? PROMOCIONES_EN[promocion.id] : undefined;
const descripcion = suyo?.descripcion ?? promocion.descripcion;
const aviso = suyo?.aviso ?? promocion.aviso;
const incluye = suyo?.incluye ?? promocion.incluye;

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/inmuebles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const galeria = promocion.galeria
  .map((nombre) => ({ nombre, imagen: fotos[`../../../assets/inmuebles/${nombre}.jpg`]?.default }))
  .filter((f) => f.imagen);

const estado = ESTADOS[promocion.estado];
const estadoEn = idioma === 'en' ? ESTADOS_EN[promocion.estado] : undefined;
const oficina = OFICINAS.find((o) => o.id === promocion.oficina) ?? OFICINAS[0];
const desde = desdePromocion(promocion);
const d = disponibilidad(promocion);

/**
 * Obra nueva: IVA del 10 % más actos jurídicos documentados, en lugar del ITP
 * del 6 % de la segunda mano. Es la diferencia que más sorprende al comprador.
 */
const IVA_OBRA_NUEVA = 0.1;
const AJD_MADRID = 0.0075;
const impuestos = desde * (IVA_OBRA_NUEVA + AJD_MADRID);

const hipoteca = calcular({ precio: desde, entrada: desde * 0.2, anios: 25, interes: 3.2 });

const mensaje =
  idioma === 'en'
    ? `Hello, I am interested in the ${promocion.nombre} development (${promocion.zona}). I would like information and to visit the site.`
    : `Hola, me interesa la promoción ${promocion.nombre} (${promocion.zona}). Quería información y visitar la obra.`;
---

<Base
  idioma={idioma}
  titulo={`${promocion.nombre} · ${tt.obraNuevaEn}, ${promocion.zona} | ${EMPRESA.nombreCompleto}`}
  descripcion={descripcion.slice(0, 155)}
>
  <div class="contenedor">
    <nav class="miga" aria-label={todo.comun.dondeEstas}>
      <a href={enlaceDe(idioma, '/')}>{todo.comun.inicio}</a>
      <span aria-hidden="true">›</span>
      <a href={enlaceDe(idioma, '/obra-nueva')}>{todo.obraNueva.antetitulo}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{promocion.nombre}</span>
    </nav>

    <section class="galeria" aria-label={tt.imagenes}>
      {
        galeria.map((foto, i) => (
          <figure class:list={['galeria__hueco', { 'galeria__hueco--principal': i === 0 }]}>
            <Image
              src={foto.imagen!}
              alt={`${promocion.nombre}, ${promocion.zona}`}
              widths={[600, 1000, 1600]}
              sizes={i === 0 ? '(max-width: 60rem) 92vw, 60vw' : '(max-width: 60rem) 46vw, 20vw'}
              loading={i === 0 ? 'eager' : 'lazy'}
              class="galeria__imagen"
            />
          </figure>
        ))
      }
    </section>

    <div class="detalle">
      <div class="detalle__principal">
        <header class="cabeza">
          <p class="cabeza__zona">
            {tt.obraNuevaEn} · {promocion.zona}, {promocion.provincia}
          </p>
          <h1 class="cabeza__titulo">{promocion.nombre}</h1>
          <p class="cabeza__estado">
            <span class:list={['sello', `sello--${estado.tono}`]}>
              {estadoEn?.nombre ?? estado.nombre}
            </span>
            {estadoEn?.explica ?? estado.explica}
          </p>
        </header>

        <section class="descripcion">
          <h2 class="apartado">{tt.laPromocion}</h2>
          <p>{descripcion}</p>
          <p class="aviso">
            <strong>{todo.ficha.conviene}</strong>
            {aviso}
          </p>
        </section>

        <section class="tipologias">
          <h2 class="apartado">{tt.queQueda}</h2>
          <p class="tipologias__entrada">{tt.tipologiasEntrada}</p>

          <div class="tabla">
            <div class="tabla__cabeza" aria-hidden="true">
              <span>{tt.vivienda}</span>
              <span>{tt.superficie}</span>
              <span>{todo.comun.desde}</span>
              <span>{todo.obraNueva.quedan}</span>
            </div>

            <ul>
              {
                promocion.tipologias.map((fila) => (
                  <li class:list={['fila', { 'fila--pocas': fila.disponibles <= 2 }]}>
                    <span class="fila__nombre">
                      {fila.dormitorios} {todo.comun.dormitorios.toLowerCase()}
                      <em>
                        {fila.banos} {todo.comun.banos.toLowerCase()}
                        {fila.exterior ? ` · ${tt.terrazaDe} ${fila.exterior} m²` : ''}
                      </em>
                    </span>
                    <span class="fila__dato">
                      <span class="fila__movil">{tt.superficie}</span>
                      {fila.metros} m²
                    </span>
                    <span class="fila__dato fila__dato--precio">
                      <span class="fila__movil">{todo.comun.desde}</span>
                      {euros(fila.desde)}
                    </span>
                    <span class="fila__dato">
                      <span class="fila__movil">{todo.obraNueva.quedan}</span>
                      {fila.disponibles} {todo.obraNueva.de} {fila.total}
                      {fila.disponibles <= 2 && <em class="fila__ultimas">{tt.ultimas}</em>}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <section class="incluye">
          <h2 class="apartado">{tt.queIncluye}</h2>
          <ul class="incluye__lista">
            {incluye.map((cosa) => <li>{cosa}</li>)}
          </ul>
        </section>

        <section class="numeros">
          <h2 class="apartado">{tt.numeros}</h2>
          <p class="numeros__entrada">{tt.numerosEntrada(euros(desde))}</p>

          <div class="numeros__suma">
            <div class="numeros__linea">
              <span>{tt.precio}</span>
              <span>{euros(desde)}</span>
            </div>
            <div class="numeros__linea">
              <span>{tt.impuestos}</span>
              <span>{euros(impuestos)}</span>
            </div>
            <div class="numeros__linea numeros__linea--total">
              <span>{tt.total}</span>
              <span>{euros(desde + impuestos)}</span>
            </div>
          </div>

          <p class="numeros__cuota">
            {tt.cuotaAntes}
            <strong>{euros(hipoteca.cuota)} {tt.cuotaDespues}</strong>.
            <a href={enlaceDe(idioma, '/calculadora-hipotecaria')}>{tt.cuotaEnlace}</a>
          </p>
        </section>
      </div>

      <aside class="lateral">
        <div class="tarjeta">
          <p class="tarjeta__etiqueta">{todo.comun.desde}</p>
          <p class="tarjeta__precio">{euros(desde)}</p>

          <dl class="tarjeta__datos">
            <div>
              <dt>{todo.obraNueva.entrega}</dt>
              <dd>{promocion.entrega}</dd>
            </div>
            <div>
              <dt>{tt.promotora}</dt>
              <dd>{promocion.promotora}</dd>
            </div>
            <div>
              <dt>{tt.energia}</dt>
              <dd>{tt.certificacion} {promocion.energia}</dd>
            </div>
            <div>
              <dt>{tt.disponibles}</dt>
              <dd>{d.quedan} {todo.obraNueva.de} {d.total}</dd>
            </div>
          </dl>

          <a class="boton boton--laton tarjeta__cta" href={enlaceWhatsApp(EMPRESA.whatsappCitas, mensaje)}>
            {tt.pedirInfo}
          </a>

          <a class="boton boton--linea tarjeta__llamar" href={enlaceTelefono(oficina.telefonos[0])}>
            {todo.comun.llamarA} {oficina.nombre}
          </a>

          <div class="tarjeta__oficina">
            <p class="tarjeta__pie-etiqueta">{tt.laComercializa}</p>
            <p class="tarjeta__nombre">
              <a href={enlaceDe(idioma, `/oficina/${oficina.id}`)}>
                {todo.ficha.oficinaDe} {oficina.nombre}
              </a>
            </p>
            <a class="tarjeta__telefono" href={enlaceTelefono(oficina.telefonos[0])}>
              {telefonoLegible(oficina.telefonos[0])}
            </a>
          </div>
        </div>
      </aside>
    </div>

    <section class="otras">
      <h2 class="otras__titulo" data-titular>{tt.otras}</h2>
      <ul class="otras__lista">
        {
          PROMOCIONES.filter((p) => p.id !== promocion.id).map((otra) => (
            <li>
              <a class="otra" href={enlaceDe(idioma, `/promocion/${otra.id}`)}>
                <span class="otra__nombre">{otra.nombre}</span>
                <span class="otra__zona">
                  {otra.zona} · {todo.comun.desde.toLowerCase()} {euros(desdePromocion(otra))}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- Misma barra de móvil que en la ficha de inmueble: en pantalla pequeña
       la tarjeta de contacto queda al final de una página larga. -->
  <div class="acciones">
    <div>
      <p class="acciones__cifra">{todo.comun.desde} {euros(desde)}</p>
      <p class="acciones__nota">{d.quedan} {tt.disponibles.toLowerCase()}</p>
    </div>
    <div class="acciones__botones">
      <a
        class="acciones__llamar"
        href={enlaceTelefono(oficina.telefonos[0])}
        aria-label={todo.comun.llamarA}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="acciones__info" href={enlaceWhatsApp(EMPRESA.whatsappCitas, mensaje)}>
        {tt.informacion}
      </a>
    </div>
  </div>
</Base>

<style>
  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    padding-block: var(--e-6) var(--e-4);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .miga a {
    text-decoration: none;
  }

  .miga a:hover {
    color: var(--laton-hondo);
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--e-2);
    margin-bottom: var(--e-12);
  }

  @media (min-width: 56rem) {
    .galeria {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    .galeria__hueco--principal {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .galeria__hueco {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radio);
    aspect-ratio: 4 / 3;
    background: var(--grafito-medio);
  }

  .galeria__hueco--principal {
    grid-column: span 2;
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 56rem) {
    .galeria__hueco--principal {
      aspect-ratio: auto;
    }
  }

  .galeria__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--curva);
  }

  @media (hover: hover) {
    .galeria__hueco:hover .galeria__imagen {
      transform: scale(1.05);
    }
  }

  .detalle {
    display: grid;
    gap: var(--e-8);
  }

  @media (min-width: 60rem) {
    .detalle {
      grid-template-columns: 1fr 21rem;
      gap: var(--e-12);
      align-items: start;
    }
  }

  .cabeza__zona {
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .cabeza__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-titulo);
    letter-spacing: -0.03em;
  }

  .cabeza__estado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .sello {
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sello--laton {
    background: var(--laton);
    color: #fff;
  }

  .sello--oliva {
    background: var(--oliva);
    color: #fff;
  }

  .sello--grafito {
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .apartado {
    margin-bottom: var(--e-4);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .descripcion {
    margin-top: var(--e-10);
  }

  .descripcion p {
    max-width: 44rem;
  }

  .aviso {
    margin-top: var(--e-5);
    padding: var(--e-4) var(--e-5);
    border-left: 3px solid var(--laton);
    border-radius: 0 var(--radio) var(--radio) 0;
    background: var(--arena-honda);
    font-size: var(--t-pequeno);
  }

  .tipologias,
  .incluye,
  .numeros {
    margin-top: var(--e-12);
  }

  .tipologias__entrada,
  .numeros__entrada {
    max-width: 40rem;
    margin-bottom: var(--e-5);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .tabla__cabeza {
    display: none;
  }

  @media (min-width: 44rem) {
    .tabla__cabeza {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: var(--e-4);
      padding-bottom: var(--e-3);
      border-bottom: 1px solid var(--arena-honda);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--texto-suave);
    }
  }

  .fila {
    display: grid;
    gap: var(--e-2);
    padding-block: var(--e-4);
    border-bottom: 1px solid var(--arena-honda);
  }

  @media (min-width: 44rem) {
    .fila {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: var(--e-4);
      align-items: baseline;
    }
  }

  .fila__nombre {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .fila__nombre em {
    display: block;
    font-family: var(--fuente-texto);
    font-style: normal;
    font-size: var(--t-micro);
    font-weight: 400;
    color: var(--texto-suave);
  }

  .fila__dato {
    font-variant-numeric: tabular-nums;
  }

  .fila__dato--precio {
    font-weight: 700;
  }

  /* En móvil no hay cabecera de tabla, así que cada dato lleva su nombre. */
  .fila__movil {
    display: inline-block;
    min-width: 6em;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  @media (min-width: 44rem) {
    .fila__movil {
      display: none;
    }
  }

  .fila__ultimas {
    margin-left: var(--e-2);
    padding: 0.1em 0.5em;
    border-radius: var(--radio-pildora);
    background: #a1553f;
    color: #fff;
    font-style: normal;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .incluye__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .incluye__lista li {
    padding: 0.35em 0.9em;
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-pequeno);
  }

  .numeros__suma {
    padding: var(--e-5) var(--e-6);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .numeros__linea {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-2);
    font-size: var(--t-pequeno);
    font-variant-numeric: tabular-nums;
  }

  .numeros__linea--total {
    margin-top: var(--e-2);
    padding-top: var(--e-4);
    border-top: 1px solid rgba(246, 248, 252, 0.2);
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--laton-claro);
  }

  .numeros__cuota {
    margin-top: var(--e-4);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .numeros__cuota a {
    margin-left: var(--e-2);
  }

  /* ---- Lateral ---- */

  .lateral {
    position: static;
  }

  @media (min-width: 60rem) {
    .lateral {
      position: sticky;
      top: 7rem;
    }
  }

  .tarjeta {
    padding: var(--e-6);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .tarjeta__etiqueta {
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .tarjeta__precio {
    margin-block: var(--e-1) var(--e-5);
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .tarjeta__datos {
    margin-bottom: var(--e-6);
    padding-bottom: var(--e-5);
    border-bottom: 1px solid rgba(246, 248, 252, 0.18);
  }

  .tarjeta__datos > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-3);
    padding-block: var(--e-2);
  }

  .tarjeta__datos dt {
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8d96b4;
  }

  .tarjeta__datos dd {
    margin: 0;
    font-size: var(--t-pequeno);
    font-weight: 700;
    text-align: right;
  }

  .tarjeta__cta,
  .tarjeta__llamar {
    width: 100%;
  }

  .tarjeta__llamar {
    margin-top: var(--e-3);
    border-color: rgba(246, 248, 252, 0.32);
    color: var(--texto-claro);
  }

  .tarjeta__oficina {
    margin-top: var(--e-6);
    padding-top: var(--e-5);
    border-top: 1px solid rgba(246, 248, 252, 0.18);
  }

  .tarjeta__pie-etiqueta {
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8d96b4;
  }

  .tarjeta__nombre {
    margin-top: var(--e-1);
    font-weight: 700;
  }

  .tarjeta__nombre a {
    color: var(--texto-claro);
    text-decoration: none;
  }

  .tarjeta__nombre a:hover {
    color: var(--laton-claro);
  }

  .tarjeta__telefono {
    font-weight: 700;
    color: var(--laton-claro);
  }

  /* ---- Otras ---- */

  .otras {
    margin-top: var(--e-24);
  }

  .otras__titulo {
    margin-bottom: var(--e-6);
    font-size: var(--t-titulo);
  }

  .otras__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--arena-honda);
    border-block: 1px solid var(--arena-honda);
  }

  .otra {
    display: block;
    padding: var(--e-6);
    background: var(--papel);
    text-decoration: none;
    transition: background-color var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .otra:hover {
      background: var(--arena);
    }
  }

  .otra__nombre {
    display: block;
