---
import Base from '../layouts/Base.astro';
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../data/empresa';
---

<Base titulo="Trabaja con nosotros | Raiz Inmobiliaria" descripcion="Buscamos gente de barrio para nuestras oficinas de Madrid. Sin experiencia inmobiliaria previa.">
  <div class="contenedor">
    <header class="portadilla" data-revelar>
      <p class="antetitulo">Empleo</p>
      <h1 class="portadilla__titulo">Buscamos gente<br /><span class="acento">de barrio</span></h1>
      <p class="portadilla__entrada">No pedimos experiencia inmobiliaria. Pedimos que sepas escuchar y que te guste tu barrio.</p>
    </header>

    <div class="bloques" data-revelar>
      <div class="bloque">
        <h3>Asesor comercial</h3>
        <p>
          Captacion y venta en tu zona. Fijo mas variable, formacion pagada y
          cartera de la oficina desde el primer dia.
        </p>
      </div>
      <div class="bloque">
        <h3>Administracion</h3>
        <p>
          Contratos, documentacion y coordinacion con notarias. Jornada completa
          en la sede de Cuatro Vientos.
        </p>
      </div>
      <div class="bloque">
        <h3>Practicas</h3>
        <p>
          Convenio con centros de FP y universidad. El oficio se aprende en la
          calle, no archivando papeles.
        </p>
      </div>
    </div>

    <div class="prosa" data-revelar>
      <h2>Que ofrecemos</h2>
      <ul>
        <li>Contrato laboral, no falso autonomo</li>
        <li>Formacion pagada durante los primeros meses</li>
        <li>Cartera de la oficina desde el primer dia</li>
        <li>Horario de oficina, con sabado por la manana rotativo</li>
      </ul>
      <h2>Como apuntarte</h2>
      <p>
        Escribenos por WhatsApp contando en dos lineas quien eres y que buscas.
        No hace falta carta de presentacion ni curriculum maquetado: si encaja,
        te llamamos y hablamos.
      </p>
    </div>

    <aside class="cierre" data-revelar>
      <h2>Cuentanos quien eres</h2>
      <p>Dos lineas por WhatsApp bastan para empezar.</p>
      <div class="cierre__acciones">
        <a class="boton boton--laton" href="/cita">Pedir cita</a>
        <a class="boton boton--linea cierre__linea" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
          {telefonoLegible(EMPRESA.telefonoGratuito)}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .portadilla {
    padding-block: var(--e-12) var(--e-8);
  }

  @media (min-width: 48rem) {
    .portadilla {
      padding-block: var(--e-16) var(--e-12);
    }
  }

  .portadilla__titulo {
    margin-block: var(--e-3) var(--e-4);
    font-size: var(--t-heroe);
  }

  .acento {
    color: var(--laton-hondo);
    font-style: italic;
  }

  .portadilla__entrada {
    font-size: var(--t-medio);
    color: var(--texto-suave);
  }

  .bloques {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-8);
    margin-bottom: var(--e-16);
  }

  .bloque {
    padding-top: var(--e-4);
    border-top: 2px solid var(--grafito);
  }

  .bloque h2,
  .bloque h3 {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .bloque p {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .prosa {
    max-width: 42rem;
    margin-bottom: var(--e-16);
  }

  .prosa h2 {
    margin-block: var(--e-8) var(--e-3);
    font-size: var(--t-grande);
  }

  .prosa p,
  .prosa li {
    margin-bottom: var(--e-3);
    color: var(--texto-suave);
  }

  .prosa ul {
    margin-bottom: var(--e-4);
    padding-left: var(--e-6);
    list-style: disc;
  }

  .cierre {
    padding: var(--e-12) var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--grafito);
    color: var(--texto-claro);
    text-align: center;
  }

  .cierre h2 {
    margin-bottom: var(--e-3);
    font-size: var(--t-grande);
  }

  .cierre p {
    margin-inline: auto;
    margin-bottom: var(--e-6);
    color: #cfc9bd;
  }

  .cierre__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    justify-content: center;
  }

  .cierre__linea {
    color: var(--texto-claro);
    border-color: rgba(244, 240, 233, 0.4);
  }
</style>
