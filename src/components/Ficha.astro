---
import { Image } from 'astro:assets';
import type { Inmueble } from '../data/inmuebles';
import { OPERACIONES, TIPOS, precioLegible } from '../data/inmuebles';

interface Props {
  inmueble: Inmueble;
  retraso?: number;
}

const { inmueble, retraso = 0 } = Astro.props;
const { operacion, tipo } = inmueble;

/**
 * Las fotografías se cargan del directorio de recursos y Astro las optimiza:
 * convierte a WebP, genera varios tamaños y sirve a cada pantalla el suyo.
 */
const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/inmuebles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const foto = fotos[`../assets/inmuebles/${inmueble.imagen}.jpg`]?.default;
---

<article class="ficha" data-revelar data-revelar-retraso={retraso}>
  <div class="ficha__foto">
    {
      foto && (
        <Image
          src={foto}
          alt={`${TIPOS[tipo]} en ${inmueble.zona}`}
          widths={[400, 700, 1000]}
          sizes="(max-width: 48rem) 92vw, (max-width: 72rem) 46vw, 24rem"
          loading="lazy"
          decoding="async"
          class="ficha__imagen"
        />
      )
    }

    <span class="ficha__operacion">{OPERACIONES[operacion].titulo}</span>

    <button
      class="favorito"
      type="button"
      data-favorito={inmueble.id}
      aria-pressed="false"
      aria-label="Guardar en favoritos"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 20s-7-4.4-7-9.3A4 4 0 0 1 12 8a4 4 0 0 1 7-2.7c0 4.9-7 9.3-7 9.3Z"
          transform="translate(0 1)"
        />
      </svg>
    </button>

    <div class="ficha__precio">
      {precioLegible(inmueble.precio)}<span>{OPERACIONES[operacion].sufijo}</span>
    </div>
  </div>

  <div class="ficha__cuerpo">
    <p class="ficha__zona">{TIPOS[tipo]} · {inmueble.zona}, {inmueble.provincia}</p>

    <h3 class="ficha__titulo">{inmueble.titulo}</h3>

    <ul class="ficha__datos">
      {inmueble.habitaciones > 0 && <li>{inmueble.habitaciones} hab.</li>}
      <li>{inmueble.banos} baños</li>
      <li>{inmueble.metros} m²</li>
      {inmueble.planta && <li>{inmueble.planta}</li>}
    </ul>

    <ul class="ficha__extras">
      {inmueble.extras.map((extra) => <li>{extra}</li>)}
    </ul>
  </div>
</article>

<style>
  .ficha {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radio-grande);
    background: var(--papel);
    box-shadow: 0 2px 10px var(--sombra);
    transition:
      transform var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  @media (hover: hover) {
    .ficha:hover {
      transform: translateY(-6px);
      box-shadow: 0 22px 50px var(--sombra-honda);
    }

    .ficha:hover .ficha__imagen {
      transform: scale(1.06);
    }
  }

  .ficha__foto {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--grafito-medio);
  }

  .ficha__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--curva);
  }

  /* Velo inferior para que el precio se lea sobre cualquier foto. */
  .ficha__foto::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(20, 23, 28, 0.85), transparent);
    pointer-events: none;
  }

  .ficha__operacion {
    position: absolute;
    top: var(--e-3);
    left: var(--e-3);
    z-index: 2;
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    background: rgba(20, 23, 28, 0.78);
    backdrop-filter: blur(6px);
    color: var(--texto-claro);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* ---- Favorito ---- */

  .favorito {
    position: absolute;
    top: var(--e-3);
    right: var(--e-3);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(20, 23, 28, 0.55);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    transition:
      background-color var(--dur-corta) var(--curva),
      transform var(--dur-corta) var(--curva);
  }

  .favorito svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    transition: fill var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .favorito:hover {
      background: rgba(20, 23, 28, 0.8);
      transform: scale(1.08);
    }
  }

  .favorito[aria-pressed='true'] {
    background: var(--laton);
    color: var(--grafito);
  }

  .favorito[aria-pressed='true'] svg {
    fill: currentColor;
  }

  /* Latido al guardarlo: el gesto se confirma sin necesidad de un aviso. */
  .favorito--late {
    animation: latir 520ms var(--curva);
  }

  @keyframes latir {
    0% { transform: scale(1); }
    35% { transform: scale(1.32); }
    60% { transform: scale(0.94); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorito--late {
      animation: none;
    }
  }

  .ficha__precio {
    position: absolute;
    bottom: var(--e-4);
    left: var(--e-4);
    z-index: 2;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1;
    color: var(--texto-claro);
    text-shadow: 0 2px 14px rgba(20, 23, 28, 0.6);
  }

  .ficha__precio span {
    font-family: var(--fuente-texto);
    font-size: var(--t-pequeno);
    font-weight: 500;
    opacity: 0.85;
  }

  .ficha__cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--e-6);
  }

  .ficha__zona {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .ficha__titulo {
    margin-block: var(--e-2) var(--e-4);
    font-size: var(--t-medio);
  }

  .ficha__datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-bottom: var(--e-4);
    padding-bottom: var(--e-3);
    border-bottom: 1px solid var(--arena-honda);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .ficha__datos li + li::before {
    content: '·';
    margin-right: var(--e-3);
    color: var(--arena-honda);
  }

  .ficha__extras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: auto;
  }

  .ficha__extras li {
    padding: 0.2em 0.7em;
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }
</style>
