---
import { Image } from 'astro:assets';
import type { Inmueble } from '../data/inmuebles';
import { OPERACIONES, TIPOS } from '../data/inmuebles';
import Energia from './Energia.astro';
import { textos, ruta as enlaceDe, type Idioma } from '../i18n';
import {
  tituloDe,
  tipoDe,
  operacionDe,
  precioDe,
  extraDe,
  plantaDe,
} from '../i18n/datos';

interface Props {
  inmueble: Inmueble;
  retraso?: number;
  idioma?: Idioma;
}

const { inmueble, retraso = 0, idioma = 'es' } = Astro.props;
const { operacion, tipo } = inmueble;
const t = textos(idioma);

const nombreTipo = tipoDe(tipo, TIPOS[tipo], idioma);
const laOperacion = operacionDe(operacion, OPERACIONES[operacion], idioma);

/**
 * Las fotografías se cargan del directorio de recursos y Astro las optimiza:
 * convierte a WebP, genera varios tamaños y sirve a cada pantalla el suyo.
 */
const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/inmuebles/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const foto = fotos[`../assets/inmuebles/${inmueble.imagen}.jpg`]?.default;

/*
 * Carrusel de la tarjeta.
 *
 * Enseñar una sola fotografía obliga a entrar en la ficha para saber si el
 * piso merece la pena. Con el carrusel se descarta o se elige desde el
 * listado, que es como se mira en los portales.
 *
 * La principal va primero aunque se repita dentro de la galería.
 */
const carrusel = [
  inmueble.imagen,
  ...inmueble.galeria.filter((n) => n !== inmueble.imagen),
]
  .map((nombre) => ({ nombre, imagen: fotos[`../assets/inmuebles/${nombre}.jpg`]?.default }))
  .filter((f): f is { nombre: string; imagen: ImageMetadata } => Boolean(f.imagen));
---

<article class="ficha" data-revelar data-revelar-retraso={retraso}>
  <div class="ficha__foto">
    <div class="ficha__pista" data-carrusel>
      {
        carrusel.map((f, i) => (
          <Image
            src={f.imagen}
            alt={
              idioma === 'en'
                ? `${nombreTipo} in ${inmueble.zona}`
                : `${nombreTipo} en ${inmueble.zona}`
            }
            widths={[400, 700, 1000]}
            sizes="(max-width: 48rem) 92vw, (max-width: 72rem) 46vw, 24rem"
            loading="lazy"
            decoding="async"
            class="ficha__imagen"
          />
        ))
      }
    </div>

    {
      carrusel.length > 1 && (
        <>
          <button
            class="ficha__paso ficha__paso--atras"
            type="button"
            data-carrusel-atras
            aria-label={t.visor.anterior}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m15 5-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            class="ficha__paso ficha__paso--adelante"
            type="button"
            data-carrusel-adelante
            aria-label={t.visor.siguiente}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m9 5 7 7-7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <div class="ficha__puntos" aria-hidden="true">
            {/* El primero ya viene marcado: si esperase al guion habría un
                parpadeo sin ningún punto activo. */}
            {carrusel.map((_, i) => (
              <span class:list={['ficha__punto', { 'ficha__punto--activo': i === 0 }]} />
            ))}
          </div>
        </>
      )
    }

    <span class="ficha__operacion">{laOperacion.titulo}</span>

    <button
      class="favorito"
      type="button"
      data-favorito={inmueble.id}
      aria-pressed="false"
      aria-label={t.comun.guardar}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 20s-7-4.4-7-9.3A4 4 0 0 1 12 8a4 4 0 0 1 7-2.7c0 4.9-7 9.3-7 9.3Z"
          transform="translate(0 1)"
        />
      </svg>
    </button>

    <div class="ficha__precio">
      {precioDe(inmueble.precio, idioma)}<span>{laOperacion.sufijo}</span>
    </div>
  </div>

  <div class="ficha__cuerpo">
    <p class="ficha__zona">{nombreTipo} · {inmueble.zona}, {inmueble.provincia}</p>

    <h3 class="ficha__titulo">
      <a class="ficha__enlace" href={enlaceDe(idioma, `/inmueble/${inmueble.id}`)}>
        {tituloDe(inmueble, idioma)}
        <span class="ficha__area" aria-hidden="true"></span>
      </a>
    </h3>

    <ul class="ficha__datos">
      {
        inmueble.habitaciones > 0 && (
          <li>
            {inmueble.habitaciones} {idioma === 'en' ? 'bed' : 'hab.'}
          </li>
        )
      }
      <li>{inmueble.banos} {idioma === 'en' ? 'bath' : 'baños'}</li>
      <li>{inmueble.metros} m²</li>
      {inmueble.planta && <li>{plantaDe(inmueble.planta, idioma)}</li>}
    </ul>

    <p class="ficha__energia">
      <Energia energia={inmueble.energia} forma="sello" idioma={idioma} />
      {
        operacion === 'venta' && inmueble.metros > 0 && (
          <span class="ficha__metro">
            {precioDe(Math.round(inmueble.precio / inmueble.metros), idioma)}/m²
          </span>
        )
      }
    </p>

    <ul class="ficha__extras">
      {inmueble.extras.map((extra) => <li>{extraDe(extra, idioma)}</li>)}
    </ul>
  </div>
</article>

<style>
  .ficha {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radio-grande);
    background: var(--papel);
    box-shadow: 0 2px 10px var(--sombra);
    transition:
      transform var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  @media (hover: hover) {
    .ficha:hover {
      transform: translateY(-6px);
      box-shadow: 0 22px 50px var(--sombra-honda);
    }

  }

  .ficha__foto {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--grafito-medio);
  }

  /*
   * La pista se desplaza con anclaje nativo: en el móvil el deslizamiento lo
   * resuelve el navegador, sin una línea de JavaScript, y por eso va suave
   * hasta en teléfonos modestos. El guion solo mueve los botones.
   */
  .ficha__pista {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .ficha__pista::-webkit-scrollbar {
    display: none;
  }

  .ficha__imagen {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: center;
    transition: transform 1.1s var(--curva);
  }

  /* Flechas: solo con ratón, y solo al acercarse a la tarjeta. */
  .ficha__paso {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: none;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-top: -1.1rem;
    border: 0;
    border-radius: var(--radio-pildora);
    background: rgba(24, 32, 70, 0.72);
    backdrop-filter: blur(6px);
    color: #fff;
    opacity: 0;
    cursor: pointer;
    transition:
      opacity var(--dur-corta) var(--curva),
      background-color var(--dur-corta) var(--curva);
  }

  .ficha__paso svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .ficha__paso--atras {
    left: var(--e-2);
  }

  .ficha__paso--adelante {
    right: var(--e-2);
  }

  @media (hover: hover) {
    .ficha__paso {
      display: grid;
    }

    .ficha:hover .ficha__paso,
    .ficha__paso:focus-visible {
      opacity: 1;
    }

    .ficha__paso:hover {
      background: var(--laton);
    }
  }

  /* Puntos: dicen cuántas fotos hay sin tener que contarlas. */
  .ficha__puntos {
    position: absolute;
    bottom: var(--e-3);
    left: 50%;
    z-index: 3;
    display: flex;
    gap: 0.32rem;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ficha__punto {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: var(--radio-pildora);
    background: rgba(255, 255, 255, 0.45);
    transition:
      background-color var(--dur-corta) var(--curva),
      width var(--dur-corta) var(--curva);
  }

  .ficha__punto--activo {
    width: 1.05rem;
    background: #fff;
  }

  /* Velo inferior para que el precio se lea sobre cualquier foto. */
  .ficha__foto::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(24, 32, 70, 0.85), transparent);
    pointer-events: none;
  }

  .ficha__operacion {
    position: absolute;
    top: var(--e-3);
    left: var(--e-3);
    z-index: 2;
    padding: 0.3em 0.9em;
    border-radius: var(--radio-pildora);
    background: rgba(24, 32, 70, 0.78);
    backdrop-filter: blur(6px);
    color: var(--texto-claro);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* ---- Favorito ---- */

  .favorito {
    position: absolute;
    top: var(--e-3);
    right: var(--e-3);
    /* Por encima del area de pulsacion de la ficha. */
    z-index: 5;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(24, 32, 70, 0.55);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    transition:
      background-color var(--dur-corta) var(--curva),
      transform var(--dur-corta) var(--curva);
  }

  .favorito svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    transition: fill var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .favorito:hover {
      background: rgba(24, 32, 70, 0.8);
      transform: scale(1.08);
    }
  }

  .favorito[aria-pressed='true'] {
    background: var(--laton);
    color: #fff;
  }

  .favorito[aria-pressed='true'] svg {
    fill: currentColor;
  }

  /* Latido al guardarlo: el gesto se confirma sin necesidad de un aviso. */
  .favorito--late {
    animation: latir 520ms var(--curva);
  }

  @keyframes latir {
    0% { transform: scale(1); }
    35% { transform: scale(1.32); }
    60% { transform: scale(0.94); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .favorito--late {
      animation: none;
    }
  }

  .ficha__precio {
    position: absolute;
    bottom: var(--e-4);
    left: var(--e-4);
    z-index: 2;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1;
    color: var(--texto-claro);
    text-shadow: 0 2px 14px rgba(24, 32, 70, 0.6);
  }

  .ficha__precio span {
    font-family: var(--fuente-texto);
    font-size: var(--t-pequeno);
    font-weight: 500;
    opacity: 0.85;
  }

  .ficha__cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--e-6);
  }

  .ficha__zona {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .ficha__titulo {
    margin-block: var(--e-2) var(--e-4);
    font-size: var(--t-medio);
  }

  .ficha__enlace {
    text-decoration: none;
  }

  /*
    Area de pulsacion que cubre la ficha entera. Va dentro del enlace, no
    envolviendola: un <button> dentro de un <a> es HTML invalido y rompe el
    corazon de favoritos.
  */
  .ficha__area {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (hover: hover) {
    .ficha__enlace:hover {
      color: var(--laton-hondo);
    }
  }

  .ficha__enlace:focus-visible {
    outline: none;
  }

  .ficha:has(.ficha__enlace:focus-visible) {
    outline: 3px solid var(--laton);
    outline-offset: 3px;
  }

  .ficha__datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-bottom: var(--e-4);
    padding-bottom: var(--e-3);
    border-bottom: 1px solid var(--arena-honda);
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .ficha__datos li + li::before {
    content: '·';
    margin-right: var(--e-3);
    color: var(--arena-honda);
  }

  /* La letra energética y el precio por metro: los dos datos con los que
     compara quien lleva semanas mirando pisos. */
  .ficha__energia {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px solid var(--arena-honda);
  }

  .ficha__metro {
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    color: var(--texto-suave);
  }

  .ficha__extras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: auto;
  }

  .ficha__extras li {
    padding: 0.2em 0.7em;
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio-pildora);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }
</style>
