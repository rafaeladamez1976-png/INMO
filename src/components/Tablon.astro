---
import { NOVEDADES, ETIQUETAS, fechaCorta, novedadesDe } from '../data/novedades';
import { OFICINAS } from '../data/empresa';
import { porId } from '../data/inmuebles';

interface Props {
  /** Identificador de oficina, o nada para el tablón general. */
  oficina?: string;
  /** Cuántas mostrar. */
  cuantas?: number;
  /** Título de la sección. */
  titulo?: string;
}

const { oficina, cuantas = 4, titulo = 'Novedades' } = Astro.props;

const novedades = oficina ? novedadesDe(oficina, cuantas) : NOVEDADES.slice(0, cuantas);

/**
 * Tablón de novedades.
 *
 * Cada oficina publica lo suyo y ve además lo de la empresa entera. Es un
 * tablón público para clientes, no una herramienta interna: para hablar entre
 * oficinas está Google Chat y para hablar con clientes, WhatsApp.
 */
---

{
  novedades.length > 0 && (
    <section class="tablon" aria-labelledby="titulo-tablon">
      <header class="tablon__cabecera">
        <div>
          <p class="antetitulo">Tablón</p>
          <h2 id="titulo-tablon" class="tablon__titulo" data-titular>
            {titulo}
          </h2>
        </div>
        <p class="tablon__cuenta">
          Actualizado el {fechaCorta(novedades[0].fecha)}
        </p>
      </header>

      <ol class="tablon__lista">
        {novedades.map((novedad, i) => {
          const etiqueta = ETIQUETAS[novedad.tipo];
          const suya = OFICINAS.find((o) => o.id === novedad.oficina);
          const inmueble = novedad.inmueble ? porId(novedad.inmueble) : undefined;

          return (
            <li class="apunte" data-revelar data-revelar-retraso={i * 80}>
              <div class="apunte__marca">
                <time class="apunte__fecha" datetime={novedad.fecha}>
                  {fechaCorta(novedad.fecha)}
                </time>
                <span class:list={['apunte__tipo', `apunte__tipo--${etiqueta.tono}`]}>
                  {etiqueta.nombre}
                </span>
              </div>

              <div class="apunte__cuerpo">
                <h3 class="apunte__titulo">{novedad.titulo}</h3>
                <p class="apunte__texto">{novedad.texto}</p>

                <p class="apunte__pie">
                  {novedad.oficina === 'todas' ? (
                    <span class="apunte__firma">Las cuatro oficinas</span>
                  ) : (
                    suya && (
                      <a class="apunte__firma" href={`/oficina/${suya.id}`}>
                        Oficina de {suya.nombre}
                      </a>
                    )
                  )}

                  {inmueble && (
                    <a class="apunte__inmueble" href={`/inmueble/${inmueble.id}`}>
                      Ver el inmueble
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="M5 12h14M13 6l6 6-6 6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  )}
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  .tablon {
    margin-block: var(--e-16);
  }

  .tablon__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--e-4);
    margin-bottom: var(--e-8);
  }

  .tablon__titulo {
    margin-top: var(--e-3);
    font-size: var(--t-titulo);
  }

  .tablon__cuenta {
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  /* Una lista de apuntes con filete, como el tablón de corcho de una oficina
     pero compuesto como una revista. */
  .tablon__lista {
    border-top: 1px solid var(--arena-honda);
  }

  .apunte {
    display: grid;
    gap: var(--e-3);
    padding-block: var(--e-6);
    border-bottom: 1px solid var(--arena-honda);
    transition: background-color var(--dur-corta) var(--curva);
  }

  @media (min-width: 48rem) {
    .apunte {
      grid-template-columns: 11rem 1fr;
      gap: var(--e-8);
    }
  }

  .apunte__marca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
  }

  @media (min-width: 48rem) {
    .apunte__marca {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--e-2);
    }
  }

  .apunte__fecha {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .apunte__tipo {
    padding: 0.18em 0.7em;
    border-radius: var(--radio-pildora);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .apunte__tipo--laton {
    background: var(--laton);
    color: var(--grafito);
  }

  .apunte__tipo--rojo {
    background: #a1553f;
    color: #fff;
  }

  .apunte__tipo--grafito {
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .apunte__tipo--oliva {
    background: var(--oliva);
    color: #fff;
  }

  .apunte__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-medio);
  }

  .apunte__texto {
    max-width: 44rem;
    color: var(--texto-suave);
  }

  .apunte__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4);
    margin-top: var(--e-3);
    font-size: var(--t-micro);
  }

  .apunte__firma {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--laton-hondo);
    text-decoration: none;
  }

  a.apunte__firma:hover {
    text-decoration: underline;
  }

  .apunte__inmueble {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    font-weight: 700;
    text-decoration: none;
  }

  .apunte__inmueble svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .apunte__inmueble:hover svg {
      transform: translateX(3px);
    }
  }
</style>
