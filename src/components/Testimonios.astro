---
/**
 * Testimonios.
 *
 * En inmobiliaria la decisión es de confianza antes que de producto: nadie
 * firma la operación más grande de su vida con quien no le da buena espina.
 * Por eso van con nombre, barrio y operación concreta — un testimonio anónimo
 * y genérico resta credibilidad en lugar de sumarla.
 *
 * TEXTOS DE EJEMPLO para la maqueta. Los reales hay que pedírselos a clientes
 * de verdad y publicarlos con su permiso por escrito.
 */

const TESTIMONIOS = [
  {
    texto:
      'Nos dijeron un precio más bajo que otras dos agencias y nos explicaron por qué. Se vendió en cinco semanas al precio que habían dicho.',
    nombre: 'Carmen R.',
    detalle: 'Vendió su piso en Aluche',
    inicial: 'C',
  },
  {
    texto:
      'Llevábamos ocho meses buscando por nuestra cuenta. Nos enseñaron cuatro pisos y el tercero era el nuestro. Sabían exactamente qué queríamos.',
    nombre: 'Javier y Nuria',
    detalle: 'Compraron en Las Águilas',
    inicial: 'J',
  },
  {
    texto:
      'Lo que más valoro es que me cogían el teléfono. Suena a poco hasta que has tratado con quien no lo hace.',
    nombre: 'Antonio M.',
    detalle: 'Alquiló su local en Latina',
    inicial: 'A',
  },
];
---

<section class="testimonios" aria-labelledby="titulo-testimonios">
  <div class="contenedor">
    <header class="testimonios__cabecera" data-revelar>
      <p class="antetitulo">Lo que dicen</p>
      <h2 id="titulo-testimonios" class="testimonios__titulo">
        La confianza no se anuncia,<br />se comprueba
      </h2>
    </header>

    <ul class="testimonios__rejilla">
      {
        TESTIMONIOS.map((t, i) => (
          <li class="testimonio" data-revelar data-revelar-retraso={i * 110}>
            <svg class="testimonio__comilla" viewBox="0 0 32 32" aria-hidden="true">
              <path
                d="M13 8c-4.4 1.6-7 5.2-7 9.6V24h8v-8h-4c0-2.4 1.2-4.4 3-5.2zM28 8c-4.4 1.6-7 5.2-7 9.6V24h8v-8h-4c0-2.4 1.2-4.4 3-5.2z"
                fill="currentColor"></path>
            </svg>

            <blockquote class="testimonio__texto">{t.texto}</blockquote>

            <footer class="testimonio__pie">
              <span class="testimonio__inicial" aria-hidden="true">{t.inicial}</span>
              <span>
                <span class="testimonio__nombre">{t.nombre}</span>
                <span class="testimonio__detalle">{t.detalle}</span>
              </span>
            </footer>
          </li>
        ))
      }
    </ul>

    <p class="testimonios__nota" data-revelar>
      Testimonios de ejemplo para la maqueta.
    </p>
  </div>
</section>

<style>
  .testimonios {
    padding-block: var(--e-24);
    background: var(--papel);
  }

  .testimonios__cabecera {
    margin-bottom: var(--e-12);
  }

  .testimonios__titulo {
    margin-top: var(--e-3);
    font-size: var(--t-titulo);
  }

  .testimonios__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--e-6);
  }

  .testimonio {
    display: flex;
    flex-direction: column;
    padding: var(--e-8);
    border-radius: var(--radio-grande);
    background: var(--arena);
    transition:
      transform var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  @media (hover: hover) {
    .testimonio:hover {
      transform: translateY(-5px);
      box-shadow: 0 18px 44px var(--sombra);
    }
  }

  .testimonio__comilla {
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--e-4);
    color: var(--laton);
  }

  .testimonio__texto {
    flex: 1;
    margin: 0 0 var(--e-6) 0;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 20, 'opsz' 32;
    font-size: var(--t-medio);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .testimonio__pie {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    padding-top: var(--e-4);
    border-top: 1px solid var(--arena-honda);
  }

  .testimonio__inicial {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--grafito);
    color: var(--laton-claro);
    font-family: var(--fuente-titular);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .testimonio__nombre {
    display: block;
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  .testimonio__detalle {
    display: block;
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  .testimonios__nota {
    margin-top: var(--e-8);
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }
</style>
