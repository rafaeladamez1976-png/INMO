---
import { EMPRESA, telefonoLegible, enlaceTelefono } from '../data/empresa';
import { PRINCIPALES, SECUNDARIOS, LEGALES } from '../data/navegacion';

const ruta = Astro.url.pathname;
const activa = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
const algunaSecundariaActiva = SECUNDARIOS.some((e) => activa(e.href));

/**
 * Cabecera.
 *
 * En móvil el menú se abre a pantalla completa con TODAS las secciones a la
 * vista. Antes era una tira que se deslizaba en horizontal, y media web quedaba
 * fuera de pantalla sin que nada lo indicara: la calculadora existía pero no se
 * encontraba.
 *
 * A partir de tablet vuelve a ser barra, con las principales visibles y el
 * resto en un desplegable.
 */
---

<header class="cabecera">
  <div class="contenedor cabecera__interior">
    <a class="marca" href="/">
      <svg class="marca__icono" viewBox="0 0 32 32" aria-hidden="true">
        <path
          d="M4 15 16 5l12 10v13a1 1 0 0 1-1 1h-7v-9h-8v9H5a1 1 0 0 1-1-1z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      <span class="marca__texto">
        <span class="marca__nombre">{EMPRESA.nombre}</span>
        <span class="marca__bajada">{EMPRESA.descriptor}</span>
      </span>
    </a>

    <div class="cabecera__acciones">
      <a class="icono" href="/favoritos" aria-label="Ver tus favoritos">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20s-7-4.4-7-9.3A4 4 0 0 1 12 8a4 4 0 0 1 7-2.7c0 4.9-7 9.3-7 9.3Z"
            transform="translate(0 1)"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <span class="icono__cuenta" data-favoritos-cuenta hidden>0</span>
      </a>

      <a class="telefono" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <span class="telefono__numero">{telefonoLegible(EMPRESA.telefonoGratuito)}</span>
      </a>

      <button
        class="hamburguesa"
        type="button"
        data-abrir
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="hamburguesa__lineas" aria-hidden="true"><span></span><span></span></span>
        <span class="hamburguesa__texto">Menú</span>
      </button>
    </div>
  </div>

  <nav class="nav" aria-label="Navegación principal">
    <ul class="contenedor menu">
      <li>
        <a
          href="/"
          class:list={['menu__enlace', { 'menu__enlace--activa': activa('/') }]}
          aria-current={activa('/') ? 'page' : undefined}>Inicio</a
        >
      </li>

      {
        PRINCIPALES.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class:list={['menu__enlace', { 'menu__enlace--activa': activa(enlace.href) }]}
              aria-current={activa(enlace.href) ? 'page' : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }

      <li>
        <button
          class:list={['menu__enlace', { 'menu__enlace--activa': algunaSecundariaActiva }]}
          type="button"
          data-mas
          aria-expanded="false"
          aria-controls="menu-secundario"
        >
          Más
          <svg class="menu__punta" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="m6 9 6 6 6-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </li>
    </ul>

    <!--
      El panel vive fuera de la lista: un contenedor con overflow recorta todo
      lo que se posicione dentro.
    -->
    <div class="desplegable" id="menu-secundario" data-desplegable hidden>
      <ul class="desplegable__lista">
        {
          SECUNDARIOS.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class:list={['desplegable__enlace', { 'desplegable__enlace--activa': activa(enlace.href) }]}
              >
                <span class="desplegable__titulo">{enlace.texto}</span>
                {enlace.descripcion && (
                  <span class="desplegable__detalle">{enlace.descripcion}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<!-- Menú de móvil: todas las secciones, sin nada escondido -->
<div class="panel" id="menu-movil" data-panel hidden>
  <div class="panel__cabeza">
    <p class="panel__marca">{EMPRESA.nombre}</p>
    <button class="panel__cerrar" type="button" data-cerrar aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="m6 6 12 12M18 6 6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav class="panel__nav" aria-label="Todas las secciones">
    <p class="panel__grupo">Buscar</p>
    <ul class="panel__lista">
      <li>
        <a href="/" class:list={['panel__enlace', { 'panel__enlace--activa': activa('/') }]}>
          <span>Inicio</span>
        </a>
      </li>
      {
        PRINCIPALES.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class:list={['panel__enlace', { 'panel__enlace--activa': activa(enlace.href) }]}
            >
              <span>{enlace.texto}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="panel__grupo">La empresa</p>
    <ul class="panel__lista">
      {
        SECUNDARIOS.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class:list={['panel__enlace', { 'panel__enlace--activa': activa(enlace.href) }]}
            >
              <span>{enlace.texto}</span>
              {enlace.descripcion && <em>{enlace.descripcion}</em>}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="panel__pie">
      <a class="boton boton--laton panel__cta" href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
        Llamar al {telefonoLegible(EMPRESA.telefonoGratuito)}
      </a>
      <ul class="panel__legal">
        {
          LEGALES.map((enlace) => (
            <li>
              <a href={enlace.href}>{enlace.texto}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<script>
  /**
   * Menú de móvil y desplegable de "Más".
   *
   * Las escuchas globales se registran una sola vez aunque activarMenu() se
   * llame de nuevo al navegar: si no, se acumulan y el panel se cierra solo
   * nada más abrirlo.
   */
  let enganchado = false;

  function activarMenu() {
    const panel = document.querySelector<HTMLElement>('[data-panel]');
    const abrir = document.querySelector<HTMLButtonElement>('[data-abrir]');
    const cerrar = document.querySelector<HTMLButtonElement>('[data-cerrar]');
    const boton = document.querySelector<HTMLButtonElement>('[data-mas]');
    const secundario = document.querySelector<HTMLElement>('[data-desplegable]');

    if (panel && abrir && cerrar) {
      abrir.addEventListener('click', () => {
        panel.hidden = false;
        abrir.setAttribute('aria-expanded', 'true');
        // Sin esto se hace scroll de la página por detrás del panel.
        document.body.style.overflow = 'hidden';
        cerrar.focus();
      });

      cerrar.addEventListener('click', () => {
        panel.hidden = true;
        abrir.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        abrir.focus();
      });

      // Al pulsar un enlace se cierra: si no, al volver con el botón atrás el
      // panel sigue abierto y tapa la página.
      for (const enlace of panel.querySelectorAll('a')) {
        enlace.addEventListener('click', () => {
          panel.hidden = true;
          document.body.style.overflow = '';
        });
      }
    }

    if (boton && secundario) {
      boton.addEventListener('click', (evento) => {
        evento.stopPropagation();
        const abierto = !secundario.hidden;
        secundario.hidden = abierto;
        boton.setAttribute('aria-expanded', String(!abierto));
      });
    }

    if (enganchado) return;
    enganchado = true;

    document.addEventListener('click', (evento) => {
      const vivo = document.querySelector<HTMLElement>('[data-desplegable]');
      const suBoton = document.querySelector<HTMLButtonElement>('[data-mas]');
      if (!vivo || !suBoton || vivo.hidden) return;

      const destino = evento.target as Node;
      if (!vivo.contains(destino) && !suBoton.contains(destino)) {
        vivo.hidden = true;
        suBoton.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Escape') return;

      const panelVivo = document.querySelector<HTMLElement>('[data-panel]');
      if (panelVivo && !panelVivo.hidden) {
        panelVivo.hidden = true;
        document.body.style.overflow = '';
        document.querySelector<HTMLButtonElement>('[data-abrir]')?.focus();
        return;
      }

      const vivo = document.querySelector<HTMLElement>('[data-desplegable]');
      if (vivo && !vivo.hidden) {
        vivo.hidden = true;
        const suBoton = document.querySelector<HTMLButtonElement>('[data-mas]');
        suBoton?.setAttribute('aria-expanded', 'false');
        suBoton?.focus();
      }
    });
  }

  activarMenu();
  document.addEventListener('astro:after-swap', activarMenu);
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(244, 240, 233, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--arena-honda);
    transition:
      padding var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  .cabecera__interior {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-3);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    text-decoration: none;
    line-height: 1;
  }

  .marca__icono {
    width: 1.9rem;
    height: 1.9rem;
    color: var(--laton);
    flex-shrink: 0;
  }

  .marca__nombre {
    display: block;
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .marca__bajada {
    display: block;
    margin-top: 0.2em;
    font-size: 0.55rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--laton-hondo);
  }

  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: var(--e-2);
  }

  .icono {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: var(--texto);
    transition: background-color var(--dur-corta) var(--curva);
  }

  .icono svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  @media (hover: hover) {
    .icono:hover {
      background: var(--arena-honda);
    }
  }

  /* La cuenta solo aparece cuando hay algo guardado. */
  .icono__cuenta {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25em;
    border-radius: var(--radio-pildora);
    background: var(--laton);
    color: var(--grafito);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .telefono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: 2.6rem;
    padding: var(--e-2) var(--e-4);
    border-radius: var(--radio-pildora);
    background: var(--grafito);
    color: var(--texto-claro);
    font-size: var(--t-pequeno);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-corta) var(--curva);
  }

  .telefono svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (hover: hover) {
    .telefono:hover {
      background: var(--laton);
      color: var(--grafito);
    }
  }

  .hamburguesa {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 2.6rem;
    padding: var(--e-2) var(--e-4);
    border: 1px solid var(--grafito-suave);
    border-radius: var(--radio-pildora);
    background: none;
    font-size: var(--t-pequeno);
    font-weight: 700;
    cursor: pointer;
  }

  .hamburguesa__lineas {
    display: grid;
    gap: 4px;
    width: 1.1rem;
  }

  .hamburguesa__lineas span {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }

  /* ---- Barra de escritorio ---- */

  .nav {
    position: relative;
    display: none;
    border-top: 1px solid var(--arena-honda);
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e-1);
    margin: 0;
  }

  .menu__enlace {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    min-height: 3.2rem;
    padding: var(--e-3) var(--e-6);
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-size: 1.02rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--texto-suave);
    cursor: pointer;
    transition:
      color var(--dur-corta) var(--curva),
      border-color var(--dur-corta) var(--curva);
  }

  .menu__enlace--activa {
    color: var(--texto);
    border-bottom-color: var(--laton);
  }

  @media (hover: hover) {
    .menu__enlace:hover {
      color: var(--texto);
      border-bottom-color: var(--arena-honda);
    }
  }

  .menu__punta {
    width: 0.85rem;
    height: 0.85rem;
  }

  .desplegable {
    position: absolute;
    top: calc(100% - 1px);
    right: max(1rem, calc((100% - var(--ancho-pagina)) / 2 + 2rem));
    z-index: 40;
    min-width: 18rem;
    padding: var(--e-2);
    border: 1px solid var(--arena-honda);
    border-radius: var(--radio);
    background: var(--papel);
    box-shadow: 0 18px 46px var(--sombra-honda);
    animation: caer var(--dur-corta) var(--curva);
  }

  @keyframes caer {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .desplegable__lista {
    display: grid;
    gap: 2px;
  }

  .desplegable__enlace {
    display: block;
    padding: var(--e-3);
    border-radius: var(--radio);
    text-decoration: none;
    transition: background-color var(--dur-corta) var(--curva);
  }

  @media (hover: hover) {
    .desplegable__enlace:hover {
      background: var(--arena);
    }
  }

  .desplegable__enlace--activa {
    background: var(--arena);
  }

  .desplegable__titulo {
    display: block;
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  .desplegable__detalle {
    display: block;
    margin-top: 0.15em;
    font-size: var(--t-micro);
    color: var(--texto-suave);
  }

  /* A partir de 62rem cabe la barra entera sin recortar nada. */
  @media (min-width: 62rem) {
    .nav {
      display: block;
    }

    .hamburguesa {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .telefono__numero {
      display: none;
    }

    .telefono {
      width: 2.6rem;
      padding: 0;
    }

    .hamburguesa__texto {
      display: none;
    }

    .hamburguesa {
      width: 2.6rem;
      padding: 0;
      justify-content: center;
    }
  }

  /* ---- Panel de móvil ---- */

  .panel {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    background: var(--grafito);
    color: var(--texto-claro);
    overflow-y: auto;
    animation: entrarPanel var(--dur-media) var(--curva);
  }

  @keyframes entrarPanel {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }

  .panel__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--e-4) var(--e-6);
    border-bottom: 1px solid rgba(244, 240, 233, 0.16);
  }

  .panel__marca {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .panel__cerrar {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid rgba(244, 240, 233, 0.28);
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .panel__cerrar svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .panel__nav {
    flex: 1;
    padding: var(--e-6);
  }

  .panel__grupo {
    margin-bottom: var(--e-3);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .panel__lista {
    margin-bottom: var(--e-8);
    border-top: 1px solid rgba(244, 240, 233, 0.14);
  }

  .panel__enlace {
    display: block;
    padding-block: var(--e-4);
    border-bottom: 1px solid rgba(244, 240, 233, 0.14);
    text-decoration: none;
  }

  .panel__enlace span {
    font-family: var(--fuente-titular);
    font-variation-settings: 'SOFT' 10, 'opsz' 96;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .panel__enlace em {
    display: block;
    margin-top: 0.15em;
    font-style: normal;
    font-size: var(--t-micro);
    color: #9a948a;
  }

  .panel__enlace--activa span {
    color: var(--laton-claro);
  }

  .panel__pie {
    padding-top: var(--e-6);
    border-top: 1px solid rgba(244, 240, 233, 0.16);
  }

  .panel__cta {
    width: 100%;
  }

  .panel__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    margin-top: var(--e-6);
    font-size: var(--t-micro);
  }

  .panel__legal a {
    color: #9a948a;
  }
</style>
