---
import { EMPRESA, OFICINAS, telefonoLegible, enlaceTelefono } from '../data/empresa';
import { textos, ruta as enlaceDe, type Idioma } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = textos(idioma);
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <!-- El logotipo es azul sobre blanco: sobre el marino del pie va en
             su placa blanca, como el logo impreso. -->
        <span class="pie__placa">
          <Logo class="pie__logo" ancho={220} />
        </span>
        <p class="pie__descriptor">{EMPRESA.descriptor}</p>
        <p class="pie__telefono">
          <a href={enlaceTelefono(EMPRESA.telefonoGratuito)}>
            {telefonoLegible(EMPRESA.telefonoGratuito)}
          </a>
        </p>
      </div>

      {
        OFICINAS.map((oficina) => (
          <div class="pie__oficina">
            <p class="pie__titulo">
              <a class="pie__oficina-enlace" href={enlaceDe(idioma, `/oficina/${oficina.id}`)}>
                {oficina.nombre}
              </a>
            </p>
            <address class="pie__direccion">
              {oficina.direccion}
              <br />
              {oficina.cp} Madrid
            </address>
            <a class="pie__enlace" href={enlaceTelefono(oficina.telefonos[0])}>
              {telefonoLegible(oficina.telefonos[0])}
            </a>
          </div>
        ))
      }
    </div>

    <p class="pie__firma">{t.pie.firma}</p>
  </div>
</footer>

<style>
  .pie {
    margin-top: var(--e-24);
    padding-block: var(--e-16) var(--e-8);
    background: var(--grafito);
    color: var(--texto-claro);
  }

  .pie__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--e-8);
  }

  .pie__placa {
    display: inline-grid;
    place-items: center;
    padding: var(--e-3) var(--e-4);
    margin-bottom: var(--e-4);
    border-radius: var(--radio-grande);
    background: #fff;
  }

  /* :global porque la imagen la pinta el componente Logo. */
  .pie__placa :global(.pie__logo) {
    width: auto;
    height: 3.4rem;
  }

  .pie__descriptor {
    font-size: var(--t-micro);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .pie__telefono {
    margin-top: var(--e-4);
    font-size: var(--t-medio);
    font-weight: 700;
  }

  .pie__telefono a {
    color: var(--laton-claro);
    text-decoration: none;
  }

  .pie__oficina-enlace {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-corta) var(--curva);
  }

  .pie__oficina-enlace:hover {
    border-bottom-color: currentColor;
  }

  .pie__titulo {
    margin-bottom: var(--e-2);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--laton-claro);
  }

  .pie__direccion {
    font-style: normal;
    font-size: var(--t-pequeno);
    line-height: 1.7;
    opacity: 0.8;
  }

  .pie__enlace {
    display: inline-block;
    margin-top: var(--e-2);
    font-size: var(--t-pequeno);
    font-weight: 700;
    color: var(--texto-claro);
  }

  .pie__firma {
    max-width: none;
    margin-top: var(--e-16);
    padding-top: var(--e-6);
    border-top: 1px solid rgba(246, 248, 252, 0.14);
    font-size: var(--t-micro);
    opacity: 0.6;
  }
</style>
