---
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = textos(idioma).aviso;

/**
 * Aviso permanente de que esto es una maqueta.
 *
 * Va arriba del todo y no se puede cerrar. Los teléfonos y las oficinas que se
 * muestran son reales; los inmuebles no. Sin este aviso alguien podría llamar
 * por un piso que no existe, y eso no es aceptable ni en una demostración.
 */
---

<p class="aviso" role="note">
  <!-- El espacio va explícito: el compilador se come el salto de línea. -->
  <strong>{t.fuerte}</strong>{' '}
  {t.resto}
</p>

<style>
  .aviso {
    position: relative;
    z-index: 40;
    max-width: none;
    margin: 0;
    padding: var(--e-2) var(--e-4);
    background: var(--laton);
    color: #fff;
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .aviso strong {
    font-weight: 700;
  }
</style>
