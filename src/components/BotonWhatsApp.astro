---
import { EMPRESA, enlaceWhatsApp } from '../data/empresa';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = textos(idioma).flotante;

/**
 * Botón flotante de WhatsApp.
 *
 * Va al número de citas. Aparece tras bajar un poco: en la portada estorbaría
 * al primer impacto, y quien acaba de llegar todavía no quiere escribir.
 */
const enlace = enlaceWhatsApp(EMPRESA.whatsappCitas, t.mensaje);
---

<a class="flotante" href={enlace} data-flotante target="_blank" rel="noopener">
  <span class="flotante__circulo">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M20 12a8 8 0 0 1-11.9 7L4 20l1-4.1A8 8 0 1 1 20 12Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linejoin="round"></path>
      <path
        d="M9.2 9.6c.3 1.6 1.7 3.4 3.4 4.2l1-1.1 2 .8v1.4c-2.6.3-5.9-2.4-6.6-5.3Z"
        fill="currentColor"
        stroke="none"></path>
    </svg>
  </span>
  <span class="flotante__texto">{t.rotulo}</span>
</a>

<script>
  function activarFlotante() {
    const boton = document.querySelector<HTMLElement>('[data-flotante]');
    if (!boton) return;

    const mirar = () => {
      boton.classList.toggle('flotante--visible', window.scrollY > 320);
    };

    window.addEventListener('scroll', mirar, { passive: true });
    mirar();
  }

  activarFlotante();
  document.addEventListener('astro:after-swap', activarFlotante);
</script>

<style>
  .flotante {
    position: fixed;
    right: var(--e-4);
    bottom: var(--e-4);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: var(--e-2);
    border-radius: var(--radio-pildora);
    background: #1f8a4c;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 12px 32px rgba(20, 23, 28, 0.35);
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    pointer-events: none;
    transition:
      opacity var(--dur-media) var(--curva),
      transform var(--dur-media) var(--curva),
      background-color var(--dur-corta) var(--curva);
  }

  .flotante--visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .flotante__circulo {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .flotante__circulo svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .flotante__texto {
    padding-right: var(--e-4);
    font-size: var(--t-pequeno);
    font-weight: 700;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .flotante:hover {
      background: #23a05a;
    }
  }

  /* En pantalla estrecha solo el círculo: el rótulo taparía contenido. */
  @media (max-width: 30rem) {
    .flotante__texto {
      display: none;
    }
  }

  /* Late despacio para que se note sin resultar molesto. */
  @media (prefers-reduced-motion: no-preference) {
    .flotante--visible .flotante__circulo {
      animation: pulso 3.4s var(--curva) infinite;
    }
  }

  @keyframes pulso {
    0%, 88%, 100% { transform: scale(1); }
    92% { transform: scale(1.12); }
  }
</style>
